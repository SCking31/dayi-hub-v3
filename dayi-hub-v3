local function createToggle(parent, defaultOn, onChange)
    local on = defaultOn

    local btn = makeButton(parent, {
        Size = UDim2.new(0, 44, 0, 24),
        BackgroundColor3 = on and Colors.Green or Colors.ToggleOff,
        Text = "",
    })
    makeUICorner(btn, 12)
    if on then
        makeUIGradient(btn, Colors.Green, Color3.fromRGB(16, 185, 129), 135)
    end

    local knob = makeFrame(btn, {
        Size = UDim2.new(0, 18, 0, 18),
        Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        BackgroundColor3 = Colors.White,
    })
    makeUICorner(knob, 9)

    btn.MouseButton1Click:Connect(function()
        on = not on
        btn.BackgroundColor3 = on and Colors.Green or Colors.ToggleOff
        -- Remove old gradient
        local oldGrad = btn:FindFirstChild("UIGradient")
        if oldGrad then oldGrad:Destroy() end
        if on then
            makeUIGradient(btn, Colors.Green, Color3.fromRGB(16, 185, 129), 135)
        end
        -- Spring bounce for knob
        playSpringTween(knob, {
            Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
        }, "elastic", 0.4)
        -- Knob scale punch
        local origSize = knob.Size
        playSpringTween(knob, {Size = UDim2.new(0, 22, 0, 22)}, "snappy", 0.1)
        task.delay(0.1, function()
            playSpringTween(knob, {Size = origSize}, "elastic", 0.3)
        end)
        -- Ripple
        playRipple(btn, 22, 12, on and Colors.Green or Colors.ToggleOff)
        if onChange then onChange(on) end
    end)

    return btn
end

