local function updateNameESP(label, player)
    if not label or not label.Parent then return end
    local char = player.Character
    if not char or not isAlive(player) then
        label.Visible = false
        return
    end
    local head = char:FindFirstChild("Head")
    if not head then
        label.Visible = false
        return
    end
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2.5, 0))
    if not onScreen then
        label.Visible = false
        return
    end
    label.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 20)
    label.Visible = true
