local function staggerChildren(parent, delayPerItem)
    delayPerItem = delayPerItem or 0.04
    task.spawn(function()
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("GuiObject") and child.Name ~= "UIGradient" and child.Name ~= "UICorner" and child.Name ~= "UIStroke" and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" and child.Name ~= "UIGridLayout" then
                child.BackgroundTransparency = 1
                local origSize = child.Size
                child.Size = UDim2.new(0, 0, 0, 0)
                task.wait(delayPerItem)
                playSpringTween(child, {
                    Size = origSize,
                    BackgroundTransparency = 0,
                }, "elastic", 0.4)
            end
        end
    end)
end

