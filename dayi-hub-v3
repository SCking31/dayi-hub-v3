            local card = createFeatureCard(rowHolder, f.icon, f.name, f.desc, effectiveLocked, f.default, function(on)
                DayiHub.SetToggle(f.key, on)
            end, sliderConfig)
            if card and typeof(card) == "Instance" then
                card.LayoutOrder = featureIndex
            end
        end
