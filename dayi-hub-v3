createColorPickerRow = function(parent, iconText, label, accentColor, themes, currentTheme, onPick)
    local row = makeFrame(parent, {
        Size = UDim2.new(1, 0, 0, 76),
        BackgroundColor3 = Colors.Card,
    })
    makeUICorner(row, 10)
    makeUIGradient(row, Colors.CardGrad1, Colors.CardGrad2, 135)
    makeUIStroke(row, Colors.Purple, 1, 0.85)

    local accentBar = makeFrame(row, {
        Size = UDim2.new(0, 4, 1, -16),
        Position = UDim2.new(0, 0, 0.5, -30),
        BackgroundColor3 = accentColor,
    })
    makeUICorner(accentBar, 2)
    makeUIGradient(accentBar, accentColor, Color3.fromRGB(accentColor.R * 180, accentColor.G * 180, accentColor.B * 180), 180)

    local iconCircle = makeFrame(row, {
        Size = UDim2.new(0, 36, 0, 36),
        Position = UDim2.new(0, 14, 0, 8),
        BackgroundColor3 = Colors.Panel,
    })
    makeUICorner(iconCircle, 18)
    makeUIStroke(iconCircle, accentColor, 1, 0.55)
    makeUIGradient(iconCircle, Color3.fromRGB(18, 16, 28), Color3.fromRGB(12, 10, 20), 135)
    makeTextLabel(iconCircle, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = iconText,
        TextColor3 = Colors.Text,
        TextSize = 16,
        Font = Enum.Font.SourceSansBold,
    })

    makeTextLabel(row, {
        Size = UDim2.new(1, -60, 0, 18),
        Position = UDim2.new(0, 60, 0, 10),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Colors.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansBold,
    })

    local swatchContainer = makeFrame(row, {
        Size = UDim2.new(1, -28, 0, 28),
        Position = UDim2.new(0, 14, 0, 44),
        BackgroundTransparency = 1,
    })
    makeUIListLayout(swatchContainer, 6, Enum.FillDirection.Horizontal)

    local swatches = {}
    for _, themeName in ipairs(themes) do
        local theme = AccentThemes[themeName]
        local isRainbow = themeName == "Rainbow"
        local swatch = makeButton(swatchContainer, {
            Size = UDim2.new(0, 24, 0, 24),
            BackgroundColor3 = isRainbow and Color3.fromRGB(255, 255, 255) or theme.main,
            Text = isRainbow and "🌈" or "",
            TextColor3 = Colors.White,
            TextSize = 12,
        })
        makeUICorner(swatch, 12)
        local selStroke = makeUIStroke(swatch, Colors.White, 2, 1)
        if themeName == currentTheme then
            selStroke.Transparency = 0
        end
        swatch.MouseButton1Click:Connect(function()
            for _, s in ipairs(swatches) do s.Stroke.Transparency = 1 end
            selStroke.Transparency = 0
            if onPick then onPick(themeName) end
        end)
        table.insert(swatches, { Button = swatch, Stroke = selStroke })
    end
end

