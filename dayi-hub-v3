local ConfigFile = "dayi_hub_v10_config.json"
local ConfigSlotsFile = "dayi_hub_v10_configs.json"
local ConfigSlots = {}

local function serializeConfigValue(value)
    if typeof(value) == "Color3" then
        return {
            __dayiType = "Color3",
            r = value.R,
            g = value.G,
            b = value.B,
        }
    elseif type(value) == "table" then
        local copy = {}
        for k, v in pairs(value) do
            copy[k] = serializeConfigValue(v)
        end
        return copy
    end
    return value
end

local function deserializeConfigValue(value)
    if type(value) ~= "table" then
        return value
    end

    if value.__dayiType == "Color3"
        and type(value.r) == "number"
        and type(value.g) == "number"
        and type(value.b) == "number" then
        return Color3.new(value.r, value.g, value.b)
    end

    local copy = {}
    for k, v in pairs(value) do
        copy[k] = deserializeConfigValue(v)
    end
    return copy
end

local function createConfigSnapshot()
    local snapshot = {}
    for key, value in pairs(Config) do
        -- These values belong to the hub session, not to a saved feature preset.
        if key ~= "FirstLaunch"
            and key ~= "WarningAcknowledged"
            and key ~= "DeviceMode" then
            snapshot[key] = serializeConfigValue(value)
        end
    end
    return snapshot
end

local function saveConfig()
    pcall(function()
        local json = HttpService:JSONEncode(serializeConfigValue(Config))
        writefile(ConfigFile, json)
    end)
end

local function loadConfig()
    pcall(function()
        if isfile(ConfigFile) then
            local json = readfile(ConfigFile)
            local saved = HttpService:JSONDecode(json)
            if saved and type(saved) == "table" then
                local restored = deserializeConfigValue(saved)
                for k, v in pairs(restored) do
                    if Config[k] ~= nil then
                        Config[k] = v
                    end
                end
            end
        end
    end)
end

local function saveConfigSlots()
    pcall(function()
        local json = HttpService:JSONEncode(serializeConfigValue(ConfigSlots))
        writefile(ConfigSlotsFile, json)
    end)
end

local function loadConfigSlots()
    ConfigSlots = {}
    pcall(function()
        if not isfile(ConfigSlotsFile) then return end
        local json = readfile(ConfigSlotsFile)
        local saved = HttpService:JSONDecode(json)
        if type(saved) ~= "table" then return end

        local restored = deserializeConfigValue(saved)
        for _, slot in ipairs(restored) do
            if type(slot) == "table"
                and type(slot.name) == "string"
                and type(slot.settings) == "table" then
                ConfigSlots[#ConfigSlots + 1] = {
                    name = slot.name,
                    savedAt = tonumber(slot.savedAt) or os.time(),
                    settings = slot.settings,
                }
            end
        end
    end)
end

local function getConfigLimit()
    if UserPlan == "developer" then
        return math.huge
    elseif UserPlan == "premium" then
        return 10
    end
    return 3
end

local function saveNamedConfig(rawName)
    local name = tostring(rawName or ""):gsub("^%s*(.-)%s*$", "%1")
    if name == "" then
        name = "Config " .. tostring(#ConfigSlots + 1)
    end
    if #name > 32 then
        name = name:sub(1, 32)
    end

    local existingIndex
    for i, slot in ipairs(ConfigSlots) do
        if string.lower(slot.name) == string.lower(name) then
            existingIndex = i
            break
        end
    end

    if not existingIndex and #ConfigSlots >= getConfigLimit() then
        return false, "Config limit reached for your plan."
    end

    local slot = {
        name = name,
        savedAt = os.time(),
        settings = createConfigSnapshot(),
    }

    if existingIndex then
        ConfigSlots[existingIndex] = slot
    else
        ConfigSlots[#ConfigSlots + 1] = slot
    end

    saveConfigSlots()
    return true, existingIndex and "updated" or "created"
end

