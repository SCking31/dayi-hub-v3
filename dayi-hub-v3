local function startFly()
    if State.FlyConnection then State.FlyConnection:Disconnect() State.FlyConnection = nil end
    if State.FlyBodyVelocity then State.FlyBodyVelocity:Destroy() State.FlyBodyVelocity = nil end
    if State.FlyBodyGyro then State.FlyBodyGyro:Destroy() State.FlyBodyGyro = nil end
    if not Config.FlyMode then return end

    local hum = getHumanoid(LocalPlayer)
    local hrp = getHRP(LocalPlayer)
    if not hum or not hrp then return end

    hum.PlatformStand = true

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
    State.FlyBodyVelocity = bv

    local gyro = Instance.new("BodyGyro")
    gyro.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    gyro.D = 100
    gyro.P = 10000
    gyro.CFrame = Camera.CFrame
    gyro.Parent = hrp
    State.FlyBodyGyro = gyro

    State.FlyConnection = RunService.RenderStepped:Connect(function()
        local dir = Vector3.zero
        local camCF = Camera.CFrame
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camCF.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camCF.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0, 1, 0) end
        if dir.Magnitude > 0 then dir = dir.Unit * Config.FlySpeed end
        bv.Velocity = dir
        gyro.CFrame = Camera.CFrame
    end)
end

local function stopFly()
    if State.FlyConnection then State.FlyConnection:Disconnect() State.FlyConnection = nil end
    if State.FlyBodyVelocity then State.FlyBodyVelocity:Destroy() State.FlyBodyVelocity = nil end
    if State.FlyBodyGyro then State.FlyBodyGyro:Destroy() State.FlyBodyGyro = nil end
    local hum = getHumanoid(LocalPlayer)
    if hum then hum.PlatformStand = false end
end

local function toggleFly()
    if Config.FlyMode then startFly() else stopFly() end
end

local function toggleNoclip()
    if State.NoclipConnection then
        State.NoclipConnection:Disconnect()
        State.NoclipConnection = nil
    end
    if Config.Noclip then
        State.NoclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end

--==========================================================================
-- BIND KEY HANDLING
--==========================================================================
local function setupBindKey()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if Config.BindKey ~= "None" then
            local kc = keyNameToKeyCode(Config.BindKey)
            if kc and input.KeyCode == kc then
                State.BindKeyDown = true
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if Config.BindKey ~= "None" then
            local kc = keyNameToKeyCode(Config.BindKey)
            if kc and input.KeyCode == kc then
                State.BindKeyDown = false
            end
        end
    end)
end

--==========================================================================
-- UI TOGGLE KEY (RightShift)
--==========================================================================
local function setupUIToggle()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        local kc = keyNameToKeyCode(Config.UIToggleKey)
        if kc and input.KeyCode == kc then
            State.UIVisible = not State.UIVisible
            if MainFrame and MainFrameScale then
                if State.UIVisible then
                    MainFrameScale.Scale = 0.85
                    MainFrame.Visible = true
                    TweenService:Create(MainFrameScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
                else
                    local tween = TweenService:Create(MainFrameScale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85})
                    tween:Play()
                    task.delay(0.2, function()
                        MainFrame.Visible = false
                        MainFrameScale.Scale = 1
                    end)
                end
            end
        end
    end)
end

--==========================================================================
-- CHARACTER HANDLER
--==========================================================================
local function onCharacterAdded(char)
    task.wait(0.5)
    local hum = getHumanoid(LocalPlayer)
    if hum then
        State.OriginalWalkSpeed = hum.WalkSpeed
        State.OriginalJumpPower = hum.JumpPower
    end
    applyUnlimitedZoom()
    applyWalkSpeed()
    if Config.FlyMode then toggleFly() end
    if Config.Noclip then toggleNoclip() end
    refreshAllESP()
end

local function setupPlayerEvents()
    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if Config.WallhackESP or Config.SkeletonESP then
                createESPForPlayer(player)
            end
        end)
    end)
    Players.PlayerRemoving:Connect(function(player)
        removeESPForPlayer(player)
    end)
end

