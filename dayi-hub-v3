        Size = UDim2.new(1, -40, 0, 1),
        Position = UDim2.new(0, 20, 0, 266),
        BackgroundColor3 = Colors.Purple,
        BackgroundTransparency = 0.9,
        BorderSizePixel = 0,
        ZIndex = 12,
    })
    makeUICorner(divider, 1)

    -- Module list
    local modules = {
        {name = "Graphics Engine",      icon = "🎨", status = "Loading textures & shaders..."},
        {name = "Visual Modules",       icon = "👁", status = "Compiling ESP renderers..."},
        {name = "Player Utilities",     icon = "🏃", status = "Hooking humanoid events..."},
        {name = "Settings Manager",     icon = "⚙", status = "Reading config store..."},
        {name = "Premium Features",     icon = "👑", status = "Verifying license..."},
        {name = "Notification System",  icon = "🔔", status = "Binding UI events..."},
    }

    local listStartY = 280
    local rowH = 26
    local moduleLabels = {}

    for i, mod in ipairs(modules) do
        local row = makeFrame(card, {
            Size = UDim2.new(1, -40, 0, rowH),
            Position = UDim2.new(0, 20, 0, listStartY + (i - 1) * rowH),
            BackgroundColor3 = Colors.Card,
            BackgroundTransparency = 0.6,
            BorderSizePixel = 0,
            ZIndex = 12,
        })
        makeUICorner(row, 6)
        local rowStroke = Instance.new("UIStroke")
        rowStroke.Color = Color3.fromRGB(40, 40, 60)
        rowStroke.Thickness = 1
        rowStroke.Transparency = 0.7
        rowStroke.Parent = row

        local iconCircle = makeFrame(row, {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, 8, 0.5, -10),
            BackgroundColor3 = Colors.Panel,
            BorderSizePixel = 0,
            ZIndex = 13,
        })
        makeUICorner(iconCircle, 10)
        local iconStroke = Instance.new("UIStroke")
        iconStroke.Color = Colors.Purple
        iconStroke.Thickness = 1
        iconStroke.Transparency = 0.6
        iconStroke.Parent = iconCircle

        local iconLabel = makeTextLabel(iconCircle, {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = mod.icon,
            TextColor3 = Colors.TextDim,
            TextSize = 11,
            Font = Enum.Font.SourceSansBold,
            ZIndex = 14,
        })

        local nameLabel = makeTextLabel(row, {
            Size = UDim2.new(1, -90, 1, 0),
            Position = UDim2.new(0, 34, 0, 0),
            BackgroundTransparency = 1,
            Text = mod.name,
            TextColor3 = Colors.TextDim,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSans,
            ZIndex = 13,
        })

        -- Status area: spinner while loading, checkmark when done
        local statusFrame = makeFrame(row, {
            Size = UDim2.new(0, 40, 1, 0),
            Position = UDim2.new(1, -48, 0, 0),
            BackgroundTransparency = 1,
            ZIndex = 13,
        })

        -- Spinner (rotating arc)
        local spinner = makeFrame(statusFrame, {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0.5, -7, 0.5, -7),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 14,
        })
        local spinnerStroke = Instance.new("UIStroke")
        spinnerStroke.Color = Colors.Purple
        spinnerStroke.Thickness = 2
        spinnerStroke.Transparency = 0.2
        spinnerStroke.Parent = spinner
        makeUICorner(spinner, 7)
        -- Cutout to make it an arc (overlay half)
        local spinnerCut = makeFrame(spinner, {
            Size = UDim2.new(1, 1, 1, 1),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Colors.Card,
            BackgroundTransparency = 0.6,
            BorderSizePixel = 0,
            ZIndex = 15,
        })
        makeUICorner(spinnerCut, 7)

        local statusLabel = makeTextLabel(statusFrame, {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = Color3.fromRGB(100, 220, 130),
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Center,
            Font = Enum.Font.SourceSansBold,
            ZIndex = 14,
        })

        -- Spinner rotation (throttled)
        local spinnerConn
        spinnerConn = task.spawn(function()
            while spinner.Parent do
                spinner.Rotation = spinner.Rotation + 6
                task.wait(0.016)
            end
        end)

        -- Slide-in animation
        row.Position = UDim2.new(0, 50, 0, listStartY + (i - 1) * rowH)
        row.BackgroundTransparency = 1
        TweenService:Create(row, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 20, 0, listStartY + (i - 1) * rowH), BackgroundTransparency = 0.6}):Play()

        moduleLabels[i] = {
            row = row, status = statusLabel, name = mod.name, icon = mod.icon,
            iconCircle = iconCircle, iconLabel = iconLabel, nameLabel = nameLabel,
            desc = mod.status, spinner = spinner, spinnerCut = spinnerCut, spinnerConn = spinnerConn,
        }
    end

    -- Tips carousel at bottom
    local tips = {
        "Tip: Press RightShift to toggle the UI anytime",
        "Tip: Join our Discord for updates & support",
        "Tip: Premium unlocks exclusive features",
        "Tip: Customize your accent color in Settings",
    }
    local tipLabel = makeTextLabel(card, {
        Size = UDim2.new(1, -40, 0, 16),
        Position = UDim2.new(0, 20, 0, 436),
        BackgroundTransparency = 1,
        Text = tips[1],
        TextColor3 = Colors.TextFaint,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Center,
        Font = Enum.Font.SourceSans,
        ZIndex = 12,
    })
    local tipIdx = 1
    task.spawn(function()
        while tipLabel.Parent do
            task.wait(2)
            tipIdx = (tipIdx % #tips) + 1
            TweenService:Create(tipLabel, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
            task.wait(0.2)
            tipLabel.Text = tips[tipIdx]
            TweenService:Create(tipLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
        end
    end)

    -- Animate progress
    local totalSteps = #modules
    local stepDuration = 0.38

    task.spawn(function()
        for i = 1, totalSteps do
            local pct = math.floor((i / totalSteps) * 100)

            -- Update subtitle with fade
            TweenService:Create(subtitle, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
            task.wait(0.15)
            subtitle.Text = moduleLabels[i].desc
            TweenService:Create(subtitle, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

            -- Animate bar fill
            TweenService:Create(barFill, TweenInfo.new(stepDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(i / totalSteps, 0, 1, 0)}):Play()
            pctLabel.Text = pct .. "%"
            stepLabel.Text = i .. " / " .. totalSteps .. " modules"

            -- Shimmer sweep
            shimmer.Position = UDim2.new(0, -50, 0, 0)
            TweenService:Create(shimmer, TweenInfo.new(stepDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(1, -50, 0, 0)}):Play()

            -- Mark module as loaded
            local ml = moduleLabels[i]
            -- Stop spinner, show checkmark
            ml.spinnerCut:Destroy()
            ml.spinner:Destroy()
            if ml.spinnerConn then pcall(task.cancel, ml.spinnerConn) end
            ml.status.Text = "✓"
            TweenService:Create(ml.status, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextColor3 = Color3.fromRGB(100, 220, 130)}):Play()
            TweenService:Create(ml.nameLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = Colors.Text}):Play()
            TweenService:Create(ml.iconLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = Colors.Text}):Play()
            TweenService:Create(ml.iconCircle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Colors.PurpleDk}):Play()

            -- Row highlight burst
            TweenService:Create(ml.row, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Colors.Purple, BackgroundTransparency = 0.2}):Play()
            task.delay(0.3, function()
                TweenService:Create(ml.row, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Colors.Card, BackgroundTransparency = 0.6}):Play()
            end)

            task.wait(stepDuration)
        end

        -- Final 100%
        pctLabel.Text = "100%"
        stepLabel.Text = "All modules loaded"
        subtitle.Text = "Ready to launch!"
        TweenService:Create(subtitle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = Color3.fromRGB(100, 220, 130), TextTransparency = 0}):Play()

        -- Logo celebration pulse
        TweenService:Create(logoCircle, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 72, 0, 72)}):Play()
        task.delay(0.2, function()
            TweenService:Create(logoCircle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 64, 0, 64)}):Play()
        end)
        TweenService:Create(logoGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.3}):Play()
        task.delay(0.4, function()
            TweenService:Create(logoGlow, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.82}):Play()
        end)

        task.wait(0.6)

        -- Fade out with blur-like effect
        if particleConn then pcall(task.cancel, particleConn) end
        TweenService:Create(cardScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0.75}):Play()
        TweenService:Create(dim, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        TweenService:Create(cardStrokeOuter, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
        TweenService:Create(cardStrokeInner, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
        -- Fade all card children
        for _, child in ipairs(card:GetDescendants()) do
            if child:IsA("TextLabel") then
                TweenService:Create(child, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
            elseif child:IsA("Frame") and child ~= card then
                TweenService:Create(child, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
            elseif child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
            end
        end
        task.wait(0.4)
        loadGui:Destroy()
        if onComplete then onComplete() end
    end)
end

