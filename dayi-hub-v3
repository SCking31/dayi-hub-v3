local function updateSkeletonLines(lines, player)
    if not lines then return end
    local char = player.Character
    if not char then
        for _, bone in ipairs(lines) do
            bone.line.Visible = false
        end
        return
    end

    -- Detect rig type once
    local isR6 = char:FindFirstChild("Torso") ~= nil
    local espColor = Config.ESPColor or Color3.fromRGB(255, 0, 0)

    for _, bone in ipairs(lines) do
        if bone.line.Parent then
            -- Skip if this bone is for the wrong rig type
            if bone.isR6 ~= isR6 then
                bone.line.Visible = false
            else
                local p1 = char:FindFirstChild(bone.p1Name)
                local p2 = char:FindFirstChild(bone.p2Name)
                if p1 and p2 then
                    local pos1, vis1 = Camera:WorldToViewportPoint(p1.Position)
                    local pos2, vis2 = Camera:WorldToViewportPoint(p2.Position)
                    if vis1 and vis2 then
                        bone.line.Visible = true
                        bone.line.BackgroundColor3 = espColor
                        local dist = (Vector2.new(pos1.X, pos1.Y) - Vector2.new(pos2.X, pos2.Y)).Magnitude
                        local angle = math.atan2(pos2.Y - pos1.Y, pos2.X - pos1.X)
                        bone.line.Size = UDim2.new(0, dist, 0, 2)
                        bone.line.Position = UDim2.new(0, pos1.X, 0, pos1.Y)
                        bone.line.Rotation = math.deg(angle)
                    else
                        bone.line.Visible = false
                    end
                else
                    bone.line.Visible = false
                end
            end
        end
    end
end

