-- Box ESP: draws a 2D box around the player's character on screen
local function createBoxESP(player)
    local gui = getESPGui()
    local box = Instance.new("Frame")
    box.Name = "DAYI_ESP_Box_" .. player.Name
    box.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundTransparency = 1
    box.Visible = false
    box.ZIndex = 50
    box.Parent = gui

    local stroke = Instance.new("UIStroke")
    stroke.Color = Config.ESPColor or Color3.fromRGB(255, 0, 0)
    stroke.Thickness = 2
    stroke.Transparency = 0
    stroke.Parent = box

    -- Corner pieces for a premium look (4 L-shaped corners)
    local corners = {}
    local cornerLen = 12
    for i = 1, 4 do
        local vert = Instance.new("Frame")
        vert.BorderSizePixel = 0
        vert.BackgroundColor3 = Config.ESPColor or Color3.fromRGB(255, 0, 0)
        vert.Parent = box
        local horiz = Instance.new("Frame")
        horiz.BorderSizePixel = 0
        horiz.BackgroundColor3 = Config.ESPColor or Color3.fromRGB(255, 0, 0)
        horiz.Parent = box
        corners[i] = { vert = vert, horiz = horiz }
    end

    -- Health bar (left side)
    local healthBarBg = Instance.new("Frame")
    healthBarBg.Name = "HealthBarBg"
    healthBarBg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    healthBarBg.BackgroundTransparency = 0.5
    healthBarBg.BorderSizePixel = 0
    healthBarBg.Visible = false
    healthBarBg.ZIndex = 49
    healthBarBg.Parent = gui

    local healthBarFill = Instance.new("Frame")
    healthBarFill.Name = "HealthBarFill"
    healthBarFill.BorderSizePixel = 0
    healthBarFill.Visible = false
    healthBarFill.ZIndex = 50
    healthBarFill.Parent = gui

    return { box = box, stroke = stroke, corners = corners, healthBarBg = healthBarBg, healthBarFill = healthBarFill }
end

local function updateBoxESP(boxData, player)
    if not boxData or not boxData.box or not boxData.box.Parent then return end
    local char = player.Character
    if not char or not isAlive(player) then
        boxData.box.Visible = false
        boxData.healthBarBg.Visible = false
        boxData.healthBarFill.Visible = false
        return
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not head then
        boxData.box.Visible = false
        boxData.healthBarBg.Visible = false
        boxData.healthBarFill.Visible = false
        return
    end

    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then
        boxData.box.Visible = false
        boxData.healthBarBg.Visible = false
        boxData.healthBarFill.Visible = false
        return
    end

    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
    local legPos = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))

    local height = math.abs(headPos.Y - legPos.Y)
    local width = height * 0.55

    local topLeftX = pos.X - width / 2
    local topLeftY = headPos.Y

    boxData.box.Size = UDim2.new(0, width, 0, height)
    boxData.box.Position = UDim2.new(0, topLeftX, 0, topLeftY)
    boxData.box.Visible = true

    -- Update corner pieces
    local cl = 10
    local ct = 2
    local corners = boxData.corners
    -- Top-left
    corners[1].vert.Size = UDim2.new(0, ct, 0, cl)
    corners[1].vert.Position = UDim2.new(0, 0, 0, 0)
    corners[1].horiz.Size = UDim2.new(0, cl, 0, ct)
    corners[1].horiz.Position = UDim2.new(0, 0, 0, 0)
    -- Top-right
    corners[2].vert.Size = UDim2.new(0, ct, 0, cl)
    corners[2].vert.Position = UDim2.new(1, -ct, 0, 0)
    corners[2].horiz.Size = UDim2.new(0, cl, 0, ct)
    corners[2].horiz.Position = UDim2.new(1, -cl, 0, 0)
    -- Bottom-left
    corners[3].vert.Size = UDim2.new(0, ct, 0, cl)
    corners[3].vert.Position = UDim2.new(0, 0, 1, -cl)
    corners[3].horiz.Size = UDim2.new(0, cl, 0, ct)
    corners[3].horiz.Position = UDim2.new(0, 0, 1, -ct)
    -- Bottom-right
    corners[4].vert.Size = UDim2.new(0, ct, 0, cl)
    corners[4].vert.Position = UDim2.new(1, -ct, 1, -cl)
    corners[4].horiz.Size = UDim2.new(0, cl, 0, ct)
    corners[4].horiz.Position = UDim2.new(1, -cl, 1, -ct)

    -- Health bar
    if hum then
        local hp = hum.Health
        local maxHp = hum.MaxHealth
        local pct = math.clamp(hp / maxHp, 0, 1)
        local barH = height
        local fillH = barH * pct
        local barX = topLeftX - 6
        local barY = topLeftY

        boxData.healthBarBg.Size = UDim2.new(0, 3, 0, barH)
        boxData.healthBarBg.Position = UDim2.new(0, barX, 0, barY)
        boxData.healthBarBg.Visible = true

        boxData.healthBarFill.Size = UDim2.new(0, 3, 0, fillH)
        boxData.healthBarFill.Position = UDim2.new(0, barX, 0, barY + (barH - fillH))
        boxData.healthBarFill.Visible = true
        -- Color: green -> yellow -> red based on health
        if pct > 0.5 then
            boxData.healthBarFill.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
        elseif pct > 0.25 then
            boxData.healthBarFill.BackgroundColor3 = Color3.fromRGB(251, 191, 36)
        else
            boxData.healthBarFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
        end
    end
end

local function removeBoxESP(boxData)
    if not boxData then return end
    if boxData.box then boxData.box:Destroy() end
