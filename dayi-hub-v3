        Position = UDim2.new(1, -104, 0.5, -15),
        BackgroundColor3 = accentColor,
        Text = currentKey,
        TextColor3 = Colors.Text,
        TextSize = 11,
        Font = Enum.Font.SourceSansBold,
    })
    makeUICorner(keyBtn, 8)

    keyBtn.MouseButton1Click:Connect(function()
        if listening then
            listening = false
            keyBtn.Text = currentKey
            keyBtn.BackgroundColor3 = accentColor
            return
        end
        listening = true
        keyBtn.Text = "Press a key..."
        keyBtn.BackgroundColor3 = Colors.Red

        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if listening then
                listening = false
                local keyName = tostring(input.KeyCode.Name)
                currentKey = keyName
                keyBtn.Text = keyName
                keyBtn.BackgroundColor3 = accentColor
                if onKey then onKey(keyName) end
                conn:Disconnect()
            end
        end)
    end)

    return row
end

