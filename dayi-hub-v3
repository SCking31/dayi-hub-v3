local function init()
    -- Read plan from key system
    if _G.DAYI_HUB_PLAN then
        UserPlan = _G.DAYI_HUB_PLAN
    end

    loadConfig()
    loadConfigSlots()
    Config.DeviceMode = IsMobileDevice and "mobile" or "pc"

    -- Force all features OFF on startup; user enables what they want
    for _, k in ipairs({
        "UnlimitedZoom", "FPSBooster", "VFXRemover", "ParticleRemover", "CutsceneRemover", "TextureOptimizer",
        "ShadowRemover", "LightOptimizer", "WaterOptimizer", "GrassOptimizer",
        "WallhackESP", "SkeletonESP", "BoxESP", "NameESP",
        "Aimbot", "MobileAimbot", "ShowCircle",
        "SpeedHack", "BunnyHop", "AutoJump", "FlyMode", "Noclip", "InfiniteJump",
        "AntiRagdoll", "GodMode",
        "FOVCheck", "TeamCheck", "VisibilityCheck", "RGBAccent",
    }) do
        Config[k] = false
    end
    Config.CameraFOV = 70
    Config.ParticleLevel = 60
    Config.RGBSpeed = 0.003

    State.OriginalZoomMax = LocalPlayer.CameraMaxZoomDistance
    State.OriginalZoomMin = LocalPlayer.CameraMinZoomDistance
    local hum = getHumanoid(LocalPlayer)
    if hum then
        State.OriginalWalkSpeed = hum.WalkSpeed
        State.OriginalJumpPower = hum.JumpPower
    end

    local function buildMainUI()
        buildGUI()
        buildPages()

        if MainFrameScale then
            local targetScale = MobileUIScale
            MainFrameScale.Scale = targetScale * 0.85
            TweenService:Create(MainFrameScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = targetScale}):Play()
        end

        -- Apply defaults
        applyUnlimitedZoom()
        applyFPSBooster()
        applyCutsceneRemover()
        refreshAllESP()
        startESPUpdater()
        toggleAimbot()
        toggleMobileAimbot()
        updateCircle()
        startCircleUpdater()
        applyWalkSpeed()
        applyCameraFOV()
        setupBunnyHop()
        setupAutoJump()
        setupInfiniteJump()
        applyJumpPower()
        toggleFly()
        toggleNoclip()
        setupBindKey()
        setupUIToggle()
        setupPlayerEvents()

        if LocalPlayer.Character then
            onCharacterAdded(LocalPlayer.Character)
        end
        LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

        Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            Camera = Workspace.CurrentCamera
        end)

        applyAccentTheme(Config.AccentTheme)
        toggleRGBAccent()
        local planInfo = PlanDisplay[UserPlan] or PlanDisplay.free
        local toggleHint = IsMobileDevice
            and "Tap the DAYI logo button to toggle UI."
            or ("Press " .. Config.UIToggleKey .. " to toggle UI.")
        notify("DAYI HUB v11.5", "Loaded (" .. planInfo.label .. ")! " .. toggleHint, 4)
        task.delay(2, function()
            notify("Don't forget to join Discord server", "discord.gg/QFwWBWM2j", 6)
        end)
        print("[DAYI HUB] v11.5 loaded. Press " .. Config.UIToggleKey .. " to toggle UI.")
        print("[DAYI HUB] Discord: discord.gg/QFwWBWM2j")
    end

    local function continueAfterLoading()
        if Config.FirstLaunch then
            showOnboarding(buildMainUI)
        else
            buildMainUI()
            task.delay(0.5, function()
                showWelcomeBackNotification()
            end)
        end
    end

    local function continueAfterWarning()
        showLoadingScreen(function()
            if not Config.DeviceMode then
                showDeviceSelector(continueAfterLoading)
            else
                continueAfterLoading()
            end
        end)
    end

    if Config.WarningAcknowledged then
        continueAfterWarning()
    else
        showWarningUI(continueAfterWarning)
    end
end

init()
