        Position = UDim2.new(1, -130, 0, 24),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Colors.TextDim,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.SourceSans,
    })

    task.spawn(function()
        local fpsFrames = 0
        local fpsAccum = 0
        while true do
            local dt = RunService.RenderStepped:Wait()
            if dt > 0 then
                fpsAccum = fpsAccum + (1 / dt)
                fpsFrames = fpsFrames + 1
            end
            if fpsFrames >= 30 then
                local avgFps = math.floor(fpsAccum / fpsFrames)
                if statusValLabels.fps then
                    statusValLabels.fps.Text = avgFps .. " FPS"
                    if avgFps >= 50 then
                        statusValLabels.fps.TextColor3 = Colors.Green
                    elseif avgFps >= 30 then
                        statusValLabels.fps.TextColor3 = Colors.Amber
                    else
                        statusValLabels.fps.TextColor3 = Colors.Red
                    end
                end
                fpsAccum = 0
                fpsFrames = 0
            end
            local pingOk, pingVal = pcall(function() return LocalPlayer:GetNetworkPing() end)
            if pingOk and type(pingVal) == "number" and statusValLabels.ping then
                local pingMs = math.floor(pingVal * 1000)
                statusValLabels.ping.Text = pingMs .. " ms"
                if pingMs < 100 then
                    statusValLabels.ping.TextColor3 = Colors.Green
                elseif pingMs < 250 then
                    statusValLabels.ping.TextColor3 = Colors.Amber
                else
                    statusValLabels.ping.TextColor3 = Colors.Red
                end
            end
            local nowT = os.date("*t")
            clockLabel.Text = string.format("%02d:%02d:%02d", nowT.hour, nowT.min, nowT.sec)
            local months = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"}
            dateLabel.Text = months[nowT.month] .. " " .. nowT.day .. ", " .. nowT.year
        end
    end)

end

