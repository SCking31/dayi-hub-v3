local function setupBunnyHop()
    if State.BunnyHopConnection then
        State.BunnyHopConnection:Disconnect()
        State.BunnyHopConnection = nil
    end
    if State.BunnyHopSpeedConn then
        State.BunnyHopSpeedConn:Disconnect()
        State.BunnyHopSpeedConn = nil
    end
    local hum = getHumanoid(LocalPlayer)
    if hum and State.OriginalWalkSpeed then
        hum.WalkSpeed = State.OriginalWalkSpeed
    end
    if Config.BunnyHop then
        State.BunnyHopConnection = RunService.Heartbeat:Connect(function()
            local hum = getHumanoid(LocalPlayer)
            if not hum or hum.Health <= 0 then return end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                local state = hum:GetState()
                if state == Enum.HumanoidStateType.Running
                or state == Enum.HumanoidStateType.Landed
                or state == Enum.HumanoidStateType.PlatformStanding then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
        State.BunnyHopSpeedConn = RunService.Heartbeat:Connect(function()
            local hum = getHumanoid(LocalPlayer)
            if not hum or hum.Health <= 0 then return end
            local baseSpeed = State.OriginalWalkSpeed or hum.WalkSpeed
            local inAir = hum:GetState() == Enum.HumanoidStateType.Freefall
                or hum:GetState() == Enum.HumanoidStateType.Jumping
            if inAir and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                hum.WalkSpeed = baseSpeed * 1.08
            else
                hum.WalkSpeed = baseSpeed
            end
        end)
    end
end

local function setupInfiniteJump()
    if State.InfiniteJumpConn then
        State.InfiniteJumpConn:Disconnect()
        State.InfiniteJumpConn = nil
    end
    if Config.InfiniteJump then
        State.InfiniteJumpConn = UserInputService.JumpRequest:Connect(function()
            local hum = getHumanoid(LocalPlayer)
            if hum and hum.Health > 0 then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

local function applyJumpPower()
    local hum = getHumanoid(LocalPlayer)
    if hum then
        hum.JumpPower = Config.InfiniteJump and Config.JumpPower or State.OriginalJumpPower
    end
end

local function startFly()
    if State.FlyConnection then State.FlyConnection:Disconnect() State.FlyConnection = nil end
    if State.FlyBodyVelocity then State.FlyBodyVelocity:Destroy() State.FlyBodyVelocity = nil end
    if State.FlyBodyGyro then State.FlyBodyGyro:Destroy() State.FlyBodyGyro = nil end
    if not Config.FlyMode then return end

    local hum = getHumanoid(LocalPlayer)
    local hrp = getHRP(LocalPlayer)
    if not hum or not hrp then return end

    hum.PlatformStand = true

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(400000, 400000, 400000)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp
    State.FlyBodyVelocity = bv

    local gyro = Instance.new("BodyGyro")
    gyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    gyro.P = 12500
    gyro.CFrame = Camera.CFrame
    gyro.Parent = hrp
    State.FlyBodyGyro = gyro

    State.FlyConnection = RunService.Heartbeat:Connect(function()
        if not Config.FlyMode or not hrp or not bv then return end

        local move = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude > 0 then
            bv.Velocity = move.Unit * Config.FlySpeed
        else
            bv.Velocity = Vector3.new(0, 0, 0)
        end

        gyro.CFrame = Camera.CFrame
    end)
end

local function stopFly()
    if State.FlyConnection then State.FlyConnection:Disconnect() State.FlyConnection = nil end
    if State.FlyBodyVelocity then State.FlyBodyVelocity:Destroy() State.FlyBodyVelocity = nil end
    if State.FlyBodyGyro then State.FlyBodyGyro:Destroy() State.FlyBodyGyro = nil end
    local hum = getHumanoid(LocalPlayer)
    if hum then hum.PlatformStand = false end
end

local function toggleFly()
    if Config.FlyMode then startFly() else stopFly() end
end

local function toggleNoclip()
    if State.NoclipConnection then
        State.NoclipConnection:Disconnect()
        State.NoclipConnection = nil
    end
    if Config.Noclip then
        State.NoclipConnection = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end

