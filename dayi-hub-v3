        Text = label,
        TextColor3 = Colors.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansBold,
    })

    local keyBtn = makeButton(row, {
        Size = UDim2.new(0, 110, 0, 30),
        Position = UDim2.new(1, -124, 0.5, -15),
        BackgroundColor3 = accentColor,
        Text = currentKey,
        TextColor3 = Colors.Text,
        TextSize = 11,
        TextScaled = true,
        Font = Enum.Font.SourceSansBold,
    })
    makeUICorner(keyBtn, 8)
    makeUIGradient(keyBtn, accentColor, Color3.fromRGB(accentColor.R * 220, accentColor.G * 220, accentColor.B * 220), 135)
    makeUIStroke(keyBtn, Colors.White, 1, 0.8)

    keyBtn.MouseButton1Click:Connect(function()
        if listening then
            listening = false
            keyBtn.Text = currentKey
            keyBtn.BackgroundColor3 = accentColor
            local oldGrad3 = keyBtn:FindFirstChild("UIGradient")
            if oldGrad3 then oldGrad3:Destroy() end
            makeUIGradient(keyBtn, accentColor, Color3.fromRGB(accentColor.R * 220, accentColor.G * 220, accentColor.B * 220), 135)
            return
        end
        listening = true
        keyBtn.Text = "Press a key..."
        keyBtn.BackgroundColor3 = Colors.RedBright
        local oldGrad = keyBtn:FindFirstChild("UIGradient")
        if oldGrad then oldGrad:Destroy() end
        makeUIGradient(keyBtn, Colors.RedBright, Colors.Red, 135)

        local conn
        conn = UserInputService.InputBegan:Connect(function(input)
            if listening then
                listening = false
                local keyName = tostring(input.KeyCode.Name)
                currentKey = keyName
                keyBtn.Text = keyName
                keyBtn.BackgroundColor3 = accentColor
                local oldGrad2 = keyBtn:FindFirstChild("UIGradient")
                if oldGrad2 then oldGrad2:Destroy() end
                makeUIGradient(keyBtn, accentColor, Color3.fromRGB(accentColor.R * 220, accentColor.G * 220, accentColor.B * 220), 135)
                if onKey then onKey(keyName) end
                conn:Disconnect()
            end
        end)
    end)

    addRowHover(row, accentColor)
    return row
end

