            BackgroundTransparency = 1,
            Text = mod.name,
            TextColor3 = Colors.TextDim,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSans,
        })

        local statusLabel = makeTextLabel(row, {
            Size = UDim2.new(0, 40, 1, 0),
            Position = UDim2.new(1, -40, 0, 0),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = Colors.TextDim,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Right,
            Font = Enum.Font.SourceSansBold,
        })

        moduleLabels[i] = {row = row, status = statusLabel, name = mod.name}
    end

    -- Animate progress
    local totalSteps = #modules
    local stepDuration = 0.35

    task.spawn(function()
        for i = 1, totalSteps do
            local pct = math.floor((i / totalSteps) * 100)

            -- Animate bar fill
            TweenService:Create(barFill, TweenInfo.new(stepDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(i / totalSteps, 0, 1, 0)}):Play()
            pctLabel.Text = pct .. "%"

            -- Mark module as loaded with checkmark
            local ml = moduleLabels[i]
            ml.status.Text = "✔"
            TweenService:Create(ml.status, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = Color3.fromRGB(100, 220, 130)}):Play()

            task.wait(stepDuration)
        end

        -- Final 100%
        pctLabel.Text = "100%"
        task.wait(0.4)

        -- Fade out
        TweenService:Create(cardScale, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85}):Play()
        TweenService:Create(dim, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        task.wait(0.3)
        loadGui:Destroy()
        if onComplete then onComplete() end
    end)
end

local function showWelcomeBackNotification(onComplete)
    if not ScreenGui or not MainFrame then
        if onComplete then onComplete() end
        return
    end

    local notifGui = Instance.new("ScreenGui")
    notifGui.Name = "DAYI_HUB_WelcomeBack"
    notifGui.ResetOnSpawn = false
    notifGui.IgnoreGuiInset = true
    notifGui.DisplayOrder = 999
    pcall(function() notifGui.Parent = CoreGui end)
    if notifGui.Parent then
        notifGui.Parent = LocalPlayer.PlayerGui
    end

    local card = makeFrame(notifGui, {
        Size = UDim2.new(0, 360, 0, 72),
        Position = UDim2.new(0.5, -180, 0.5, -420),
        BackgroundColor3 = Colors.Card,
        BorderSizePixel = 0,
        Visible = false,
    })
    makeUICorner(card, 10)
    makeUIStroke(card, Colors.Purple, 1.5, 0)

    local accentBar = makeFrame(card, {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = Colors.Purple,
    })
    makeUICorner(accentBar, 2)

    local iconCircle = makeFrame(card, {
        Size = UDim2.new(0, 40, 0, 40),
        Position = UDim2.new(0, 14, 0.5, -20),
        BackgroundColor3 = Colors.PurpleBg,
    })
    makeUICorner(iconCircle, 20)
    makeUIStroke(iconCircle, Colors.Purple, 1, 0.4)

    makeTextLabel(iconCircle, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "👋",
        TextColor3 = Colors.White,
        TextSize = 20,
        Font = Enum.Font.SourceSansBold,
    })

    makeTextLabel(card, {
        Size = UDim2.new(1, -74, 0, 20),
        Position = UDim2.new(0, 62, 0, 14),
        BackgroundTransparency = 1,
        Text = "Welcome Back!",
        TextColor3 = Colors.Text,
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansBold,
    })

    makeTextLabel(card, {
        Size = UDim2.new(1, -74, 0, 16),
        Position = UDim2.new(0, 62, 0, 36),
        BackgroundTransparency = 1,
        Text = "Glad to see you again. Enjoy DAYI HUB!",
        TextColor3 = Colors.TextDim,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSans,
    })

    local cardScale = Instance.new("UIScale")
    cardScale.Scale = 0.6
    cardScale.Parent = card

    card.Visible = true
    card.BackgroundTransparency = 1

    TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
    TweenService:Create(cardScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    task.delay(4, function()
        TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        local outTween = TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.6})
        outTween:Play()
        outTween.Completed:Wait()
        notifGui:Destroy()
        if onComplete then onComplete() end
    end)
end

local function init()
    loadConfig()

    -- Force all features OFF on startup; user enables what they want
    for _, k in ipairs({
        "UnlimitedZoom", "FPSBooster", "VFXRemover", "TextureOptimizer",
        "ShadowRemover", "LightOptimizer", "WaterOptimizer", "GrassOptimizer",
        "WallhackESP", "SkeletonESP", "BoxESP", "NameESP",
        "Aimbot", "MobileAimbot", "ShowCircle",
        "SpeedHack", "BunnyHop", "FlyMode", "Noclip", "InfiniteJump",
        "AntiRagdoll", "GodMode",
        "FOVCheck", "TeamCheck", "VisibilityCheck",
    }) do
        Config[k] = false
    end

    State.OriginalZoomMax = LocalPlayer.CameraMaxZoomDistance
    State.OriginalZoomMin = LocalPlayer.CameraMinZoomDistance
    local hum = getHumanoid(LocalPlayer)
    if hum then
        State.OriginalWalkSpeed = hum.WalkSpeed
        State.OriginalJumpPower = hum.JumpPower
    end

    local function buildMainUI()
        buildGUI()
        buildPages()

        if MainFrameScale then
            MainFrameScale.Scale = 0.85
            TweenService:Create(MainFrameScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end

        -- Apply defaults
        applyUnlimitedZoom()
        applyFPSBooster()
        refreshAllESP()
        startESPUpdater()
        toggleAimbot()
        toggleMobileAimbot()
        updateCircle()
        startCircleUpdater()
        applyWalkSpeed()
        setupBunnyHop()
        toggleFly()
        toggleNoclip()
        setupBindKey()
        setupUIToggle()
        setupPlayerEvents()

        if LocalPlayer.Character then
            onCharacterAdded(LocalPlayer.Character)
        end
        LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

        Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            Camera = Workspace.CurrentCamera
        end)

        applyAccentTheme(Config.AccentTheme)
        notify("DAYI HUB v10.0", "Loaded! Press " .. Config.UIToggleKey .. " to toggle UI.", 4)
        task.delay(2, function()
            notify("Don't forget to join Discord server", "discord.gg/QFwWBWM2j", 6)
        end)
        print("[DAYI HUB] v10.0 loaded. Press " .. Config.UIToggleKey .. " to toggle UI.")
        print("[DAYI HUB] Discord: discord.gg/QFwWBWM2j")
    end

    -- Show warning UI first, then loading screen, then onboarding (if first launch) or main UI
    showWarningUI(function()
        showLoadingScreen(function()
            if Config.FirstLaunch then
                showOnboarding(buildMainUI)
            else
                buildMainUI()
                -- Returning user: show animated welcome-back notification (UI stays open)
                task.delay(0.5, function()
                    showWelcomeBackNotification()
                end)
            end
        end)
    end)
end

init()
