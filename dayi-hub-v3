-- Utility
--==========================================================================
local function getHRP(player)
    if not player then return nil end
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid(player)
    if not player then return nil end
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getTargetPart(player)
    local char = player and player.Character
    if not char then return nil end
    if Config.Target == "Head" then
        return char:FindFirstChild("Head")
    else
        return char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("UpperTorso")
    end
end

local function isAlive(player)
    local hum = getHumanoid(player)
    return hum ~= nil and hum.Health > 0
end

local function isSameTeam(player)
    if not Config.TeamCheck then return false end
    return player.Team == LocalPlayer.Team
end

local function isBehindWall(targetPart)
    if not Config.VisibilityCheck then return false end
    local hrp = getHRP(LocalPlayer)
    if not hrp then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }
    local result = Workspace:Raycast(hrp.Position, targetPart.Position - hrp.Position, params)
    if result and result.Instance then
        return not result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return false
end

local function keyNameToKeyCode(name)
    if not name or name == "None" or name == "" then return nil end
    local upper = name:upper()
    local special = {
        ["SPACE"]      = Enum.KeyCode.Space,
        ["ENTER"]      = Enum.KeyCode.Return,
        ["TAB"]        = Enum.KeyCode.Tab,
        ["ESC"]        = Enum.KeyCode.Escape,
        ["RIGHTSHIFT"] = Enum.KeyCode.RightShift,
        ["LEFTSHIFT"]  = Enum.KeyCode.LeftShift,
        ["RIGHTCTRL"]  = Enum.KeyCode.RightControl,
        ["LEFTCTRL"]   = Enum.KeyCode.LeftControl,
        ["RIGHTALT"]   = Enum.KeyCode.RightAlt,
        ["LEFTALT"]    = Enum.KeyCode.LeftAlt,
        ["CAPSLOCK"]   = Enum.KeyCode.CapsLock,
        ["BACKSPACE"]  = Enum.KeyCode.Backspace,
        ["UP"]         = Enum.KeyCode.Up,
        ["DOWN"]       = Enum.KeyCode.Down,
        ["LEFT"]       = Enum.KeyCode.Left,
        ["RIGHT"]      = Enum.KeyCode.Right,
    }
    if special[upper] then return special[upper] end
    for _, kc in ipairs(Enum.KeyCode:GetEnumItems()) do
        if kc.Name:upper() == upper then
            return kc
        end
    end
    return nil
end

