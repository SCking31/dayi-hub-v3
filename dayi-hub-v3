    local function updateStep()
        local s = steps[currentStep]
        local accent = s.accent

        -- Update progress bar
        local progress = currentStep / #steps
        TweenService:Create(progressFill, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Size = UDim2.new(progress, 0, 1, 0)}):Play()
