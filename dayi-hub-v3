    loadGui.Name = "DAYI_HUB_LOADING"
    loadGui.ResetOnSpawn = false
    loadGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    loadGui.IgnoreGuiInset = true
    pcall(function() loadGui.Parent = CoreGui end)
    if loadGui.Parent == nil then
        loadGui.Parent = LocalPlayer.PlayerGui
    end

    local dim = makeFrame(loadGui, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
    })

    local card = makeFrame(dim, {
        Size = UDim2.new(0, 420, 0, 340),
        Position = UDim2.new(0.5, -210, 0.5, -170),
        BackgroundColor3 = Colors.Bg,
        BorderSizePixel = 0,
    })
