        -- Update card stroke accent
        TweenService:Create(card:FindFirstChild("UIStroke"), TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = accent}):Play()

        -- Update icon glow color
        TweenService:Create(iconGlow, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = accent}):Play()

        -- Update ring stroke color
        TweenService:Create(ringStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = accent}):Play()

        -- Update subtitle color
        TweenService:Create(subtitleLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = accent}):Play()

        -- Update step counter
        stepCounter.Text = currentStep .. " / " .. #steps

        -- Set text
        iconLabel.Text = s.icon
        titleLabel.Text = s.title
        subtitleLabel.Text = s.subtitle
        bodyLabel.Text = s.body

        -- Update dots
        for i = 1, #steps do
            if i == currentStep then
                TweenService:Create(dots[i], TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = accent, Size = UDim2.new(0, 24, 0, 8), Position = UDim2.new(0, (i - 1) * 30 - 8, 0, 0)}):Play()
            elseif i < currentStep then
                TweenService:Create(dots[i], TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(100, 80, 120), Size = UDim2.new(0, 8, 0, 8), Position = UDim2.new(0, (i - 1) * 30, 0, 0)}):Play()
            else
                TweenService:Create(dots[i], TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(50, 50, 60), Size = UDim2.new(0, 8, 0, 8), Position = UDim2.new(0, (i - 1) * 30, 0, 0)}):Play()
            end
        end

        -- Fade in content with slight upward motion
        iconLabel.TextTransparency = 1
        titleLabel.TextTransparency = 1
        subtitleLabel.TextTransparency = 1
        bodyLabel.TextTransparency = 1

        TweenService:Create(iconLabel, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
