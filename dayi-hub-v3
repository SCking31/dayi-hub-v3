--==========================================================================
-- BACKGROUND PARTICLES
--==========================================================================
local ParticleState = { folder = nil, connections = {}, particles = {} }

local function clearBackgroundParticles()
    for _, c in ipairs(ParticleState.connections) do
        pcall(function() c:Disconnect() end)
    end
    ParticleState.connections = {}
    if ParticleState.folder then
        pcall(function() ParticleState.folder:Destroy() end)
    end
    ParticleState.folder = nil
    ParticleState.particles = {}
end

local function createBackgroundParticles(parent)
    clearBackgroundParticles()

    local folder = makeFrame(parent, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 1,
        ClipsDescendants = false,
    })
    ParticleState.folder = folder

    local particleColors = { Colors.Purple, Colors.Pink, Colors.Cyan, Colors.PurpleBtn, Colors.Yellow }
    local level = Config.ParticleLevel or 60
    local count = math.floor(18 + (level / 100) * 42)

    local sizeMul = 0.8 + (level / 100) * 1.2
    local alphaMul = 0.4 + (level / 100) * 0.45

    for i = 1, count do
        local color = particleColors[(i % #particleColors) + 1]
        local baseSize = math.random(3, 6)
        local size = math.floor(baseSize * sizeMul)
        local p = makeFrame(folder, {
            Size = UDim2.new(0, size, 0, size),
            Position = UDim2.new(math.random(), 0, math.random(), 0),
            BackgroundColor3 = color,
            BackgroundTransparency = math.max(0.15, 0.85 - math.random() * 0.3 * alphaMul),
            ZIndex = 2,
            BorderSizePixel = 0,
        })
        makeUICorner(p, math.floor(size / 2))

        ParticleState.particles[#ParticleState.particles + 1] = {
            frame = p,
            x = p.Position.X.Scale,
            y = p.Position.Y.Scale,
            speed = 0.0006 + math.random() * 0.0014,
            drift = (math.random() - 0.5) * 0.0008,
            phase = math.random() * math.pi * 2,
            color = color,
            baseSize = size,
            pulseSpeed = 0.01 + math.random() * 0.02,
        }
    end

    local conn
    conn = RunService.RenderStepped:Connect(function()
        for _, info in ipairs(ParticleState.particles) do
            info.phase = info.phase + info.speed
            info.y = info.y - info.speed * 0.4
            info.x = info.x + math.sin(info.phase) * info.drift
            if info.y < -0.05 then
                info.y = 1.05
                info.x = math.random()
            end
            info.frame.Position = UDim2.new(info.x, 0, info.y, 0)

            local pulse = 0.85 + math.sin(info.phase * 3) * 0.15
            info.frame.BackgroundTransparency = math.max(0.1, (1 - pulse) * (1 - alphaMul * 0.5))
        end
    end)
    ParticleState.connections[#ParticleState.connections + 1] = conn
end

