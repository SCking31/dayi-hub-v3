local function getClosestPlayer()
    local closest, closestDist = nil, Config.CircleRadius
    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) and not isSameTeam(player) then
            local targetPart = getTargetPart(player)
            if targetPart then
                if not (Config.VisibilityCheck and isBehindWall(targetPart)) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if Config.FOVCheck then
                            if dist <= Config.CircleRadius and dist < closestDist then
                                closestDist = dist
                                closest = player
                            end
                        else
                            if dist < closestDist then
                                closestDist = dist
                                closest = player
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function aimbotStep()
    if not Config.Aimbot then return end
    if Config.BindKey ~= "None" and not State.BindKeyDown then return end

    local target = getClosestPlayer()
    if target then
        local targetPart = getTargetPart(target)
        if targetPart then
            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPart.Position)
            if Config.AimbotSmoothness > 0 and Config.AimbotSmoothness < 1 then
                Camera.CFrame = currentCF:Lerp(targetCF, 1 - Config.AimbotSmoothness)
            else
                Camera.CFrame = targetCF
            end
        end
    end
end

local function toggleAimbot()
    if State.AimbotConnection then
        State.AimbotConnection:Disconnect()
        State.AimbotConnection = nil
    end
    if Config.Aimbot then
        State.AimbotConnection = RunService.RenderStepped:Connect(aimbotStep)
    end
end

