local function createPageContainer(name)
    local page = makeFrame(ContentArea, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Colors.Bg,
        BorderSizePixel = 0,
        Visible = false,
    })
    PageFrames[name] = page
    return page
end

local function createScrollContent(page, topOffset)
    local scroll = makeScrollFrame(page, {
        Size = UDim2.new(1, 0, 1, -topOffset),
        Position = UDim2.new(0, 0, 0, topOffset),
        BackgroundColor3 = Colors.Bg,
        BorderSizePixel = 0,
        ScrollBarThickness = 6,
    })
    makeUIGradient(scroll, Colors.BgGrad1, Colors.BgGrad2, 135)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    padding.PaddingTop = UDim.new(0, 10)
    padding.PaddingBottom = UDim.new(0, 10)
    padding.Parent = scroll
    return scroll
end

