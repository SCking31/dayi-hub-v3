    elseif name == "InfiniteJump" then setupInfiniteJump() applyJumpPower()
    elseif name == "FlyMode" then toggleFly()
    elseif name == "Noclip" then toggleNoclip()
    elseif name == "BackgroundParticles" then
        if value and ContentArea then
            createBackgroundParticles(ContentArea)
        else
            clearBackgroundParticles()
        end
    end
end

function DayiHub.SetSlider(name, value)
    Config[name] = value
    if name == "FPSLimit" then
        Config.FPSLimit = value
        if Config.FPSUnlocker then applyFPSUnlocker(true) end
    elseif name == "WalkSpeed" then applyWalkSpeed()
    elseif name == "CircleRadius" then updateCircle()
    elseif name == "JumpPower" then applyJumpPower()
    elseif name == "CameraFOV" then applyCameraFOV()
    elseif name == "ParticleLevel" then
        Config.ParticleLevel = value
        if Config.BackgroundParticles then
            createBackgroundParticles(ContentArea)
        end
    elseif name == "RGBSpeed" then Config.RGBSpeed = value
    elseif name == "UIScale" then
        if MainFrameScale then
            MainFrameScale.Scale = (value / 100) * MobileUIScale
        end
    end
end

function DayiHub.SetBindKey(keyName)
    Config.BindKey = keyName
    State.BindKeyDown = false
end

function DayiHub.SetUIToggleKey(keyName)
    Config.UIToggleKey = keyName
end

function DayiHub.SetAccentTheme(themeName)
    Config.AccentTheme = themeName
    applyAccentTheme(themeName)
    destroyOldGui()
    PageFrames = {}
    SidebarButtons = {}
    buildGUI()
    buildPages()
    activeTab = "Premium"
    if PageFrames["Premium"] then
        PageFrames["Premium"].Visible = true
    end
    notify("DAYI HUB", "UI color changed to " .. themeName .. ".", 3)
end

function DayiHub.SetCircleColor(color)
    Config.CircleColor = color
    updateCircle()
end

function DayiHub.SetTarget(target)
    Config.Target = target
end

getgenv().DayiHub = DayiHub

