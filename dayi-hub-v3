            TextSize = 11,
            Font = Enum.Font.SourceSansBold,
        })
        makeUICorner(loadButton, 8)
        makeUIStroke(loadButton, Colors.Purple, 1, 0.5)
        loadButton.MouseButton1Click:Connect(function()
            loadConfigSlot(slotIndex)
        end)

        local deleteButton = makeButton(row, {
            Size = UDim2.new(0, 78, 0, 30),
            Position = UDim2.new(1, -88, 0.5, -15),
            BackgroundColor3 = Color3.fromRGB(70, 22, 30),
