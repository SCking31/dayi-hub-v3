local CutsceneCameraBindName = "DAYI_CutsceneRemover_Camera"
local CutsceneNameParts = {
    "cutscene", "cut_scene", "cinematic", "cinema_scene",
    "cinematic_scene", "letterbox", "blackbar", "black_bar",
    "cinematicbar", "cinematic_bar",
}

local function isCutsceneName(name)
    local lower = string.lower(tostring(name or ""))
    for _, part in ipairs(CutsceneNameParts) do
        if lower:find(part, 1, true) then
            return true
        end
    end
    return false
end

local function findCutsceneScreenGui(obj)
    local current = obj
    while current and current ~= LocalPlayer.PlayerGui do
        if current:IsA("ScreenGui") and isCutsceneName(current.Name) then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function guardCutsceneGui(obj, property)
    if not obj or State.CutsceneGuiBackup[obj] ~= nil then return end

    local value
    pcall(function() value = obj[property] end)
    if value == nil then return end

    State.CutsceneGuiBackup[obj] = {
        property = property,
        value = value,
    }
    pcall(function() obj[property] = false end)

    local ok, signal = pcall(function()
        return obj:GetPropertyChangedSignal(property)
    end)
    if ok and signal then
        State.CutsceneGuiGuards[obj] = signal:Connect(function()
            if Config.CutsceneRemover then
                pcall(function() obj[property] = false end)
            end
        end)
    end
end

local function suppressCutsceneScript(obj)
    if not obj:IsA("LocalScript") or not isCutsceneName(obj.Name) then return end
    if State.CutsceneScriptBackup[obj] ~= nil then return end

    local wasDisabled
    pcall(function() wasDisabled = obj.Disabled end)
    if wasDisabled == nil then return end

    State.CutsceneScriptBackup[obj] = wasDisabled
    pcall(function() obj.Disabled = true end)

    local ok, signal = pcall(function()
        return obj:GetPropertyChangedSignal("Disabled")
    end)
    if ok and signal then
        State.CutsceneScriptGuards[obj] = signal:Connect(function()
            if Config.CutsceneRemover then
                pcall(function() obj.Disabled = true end)
            end
        end)
    end
end

local function suppressCutsceneGui(obj)
    pcall(function()
        suppressCutsceneScript(obj)
        if obj:IsA("ScreenGui") and isCutsceneName(obj.Name) then
            guardCutsceneGui(obj, "Enabled")
            return
        end

        if obj:IsA("GuiObject") then
            local cutsceneGui = findCutsceneScreenGui(obj)
            if cutsceneGui then
                -- Disable the named cutscene ScreenGui once, instead of
                -- hiding unrelated children one by one.
                guardCutsceneGui(cutsceneGui, "Enabled")
            elseif isCutsceneName(obj.Name) then
                -- A specifically named cutscene element inside a normal HUD
                -- is hidden by itself, preserving the rest of that HUD.
                guardCutsceneGui(obj, "Visible")
            end
        end
    end)
end

local function restoreCutsceneGuis()
    for _, connection in pairs(State.CutsceneGuiGuards) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(State.CutsceneGuiGuards)

    for obj, backup in pairs(State.CutsceneGuiBackup) do
        pcall(function()
            obj[backup.property] = backup.value
        end)
    end
    table.clear(State.CutsceneGuiBackup)
end

local function restoreCutsceneScripts()
    for _, connection in pairs(State.CutsceneScriptGuards) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(State.CutsceneScriptGuards)

    for obj, wasDisabled in pairs(State.CutsceneScriptBackup) do
        pcall(function() obj.Disabled = wasDisabled end)
    end
    table.clear(State.CutsceneScriptBackup)
end

local function scanCutsceneGuis(root)
    pcall(function()
        suppressCutsceneGui(root)
        for _, obj in ipairs(root:GetDescendants()) do
            suppressCutsceneGui(obj)
        end
    end)
end

local function backupCutsceneCamera(cam)
    if not cam or State.CutsceneCameraBackups[cam] then return end
    State.CutsceneCameraBackups[cam] = {
        cameraType = cam.CameraType,
        cameraSubject = cam.CameraSubject,
        fieldOfView = cam.FieldOfView,
    }
end

local function enforcePlayerCamera()
    local cam = Workspace.CurrentCamera
    if not cam then return end

    backupCutsceneCamera(cam)
    local hum = getHumanoid(LocalPlayer)
    if cam.CameraType ~= Enum.CameraType.Custom then
        cam.CameraType = Enum.CameraType.Custom
    end
    if hum and cam.CameraSubject ~= hum then
        cam.CameraSubject = hum
    end
    local targetFov = tonumber(Config.CameraFOV) or 70
    if math.abs(cam.FieldOfView - targetFov) > 0.1 then
        cam.FieldOfView = targetFov
    end
end

local function applyCutsceneRemover()
    pcall(function()
        if Config.CutsceneRemover then
            scanCutsceneGuis(LocalPlayer.PlayerGui)

            if not State.CutsceneGuiConnection then
                State.CutsceneGuiConnection = LocalPlayer.PlayerGui.DescendantAdded:Connect(function(obj)
                    if Config.CutsceneRemover then
                        task.defer(suppressCutsceneGui, obj)
                    end
                end)
            end

            if not State.CutsceneConnection then
                -- Camera enforcement is cheap; importantly, it never scans GUI descendants.
                RunService:BindToRenderStep(
                    CutsceneCameraBindName,
                    Enum.RenderPriority.Last.Value,
                    function()
                        if Config.CutsceneRemover then
                            enforcePlayerCamera()
                        end
                    end
                )
                State.CutsceneConnection = true
            end
        else
            if State.CutsceneConnection then
                RunService:UnbindFromRenderStep(CutsceneCameraBindName)
                State.CutsceneConnection = nil
            end
            if State.CutsceneGuiConnection then
                State.CutsceneGuiConnection:Disconnect()
                State.CutsceneGuiConnection = nil
            end

            restoreCutsceneGuis()
            restoreCutsceneScripts()

            for cam, backup in pairs(State.CutsceneCameraBackups) do
                pcall(function()
                    if cam.Parent then
                        cam.CameraType = backup.cameraType
                        cam.CameraSubject = backup.cameraSubject
                        cam.FieldOfView = backup.fieldOfView
                    end
                end)
            end
            table.clear(State.CutsceneCameraBackups)
        end
    end)
end

