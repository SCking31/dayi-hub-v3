local function createSliderRow(parent, iconText, label, min, max, defaultVal, accentColor, onChange)
    local row = makeFrame(parent, {
        Size = UDim2.new(1, 0, 0, 74),
        BackgroundColor3 = Colors.Card,
    })
    makeUICorner(row, 9)
    makeUIStroke(row, Colors.Border, 1, 0.9)

    local accentBar = makeFrame(row, {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = accentColor,
    })
    makeUICorner(accentBar, 2)

    local iconCircle = makeFrame(row, {
        Size = UDim2.new(0, 38, 0, 38),
        Position = UDim2.new(0, 14, 0, 10),
        BackgroundColor3 = Colors.Panel,
    })
    makeUICorner(iconCircle, 19)
    makeUIStroke(iconCircle, accentColor, 1, 0.55)

    makeTextLabel(iconCircle, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = iconText,
        TextColor3 = Colors.Text,
        TextSize = 17,
        Font = Enum.Font.SourceSansBold,
    })

    local valLabel = makeTextLabel(row, {
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.new(0, 64, 0, 10),
        BackgroundTransparency = 1,
        Text = label .. ": " .. tostring(defaultVal),
        TextColor3 = Colors.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansBold,
    })

    local track = makeFrame(row, {
        Size = UDim2.new(1, -120, 0, 6),
        Position = UDim2.new(0, 64, 0, 48),
        BackgroundColor3 = Color3.fromRGB(35, 35, 50),
    })
    makeUICorner(track, 3)

    local fill = makeFrame(track, {
        Size = UDim2.new((defaultVal - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = accentColor,
    })
    makeUICorner(fill, 3)

    local knob = makeFrame(track, {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((defaultVal - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Colors.White,
    })
    makeUICorner(knob, 7)
    makeUIStroke(knob, accentColor, 2, 0)

    local minLabel = makeTextLabel(row, {
        Size = UDim2.new(0, 20, 0, 14),
        Position = UDim2.new(0, 50, 0, 48),
        BackgroundTransparency = 1,
        Text = tostring(min),
        TextColor3 = Colors.TextDim,
        TextSize = 10,
        Font = Enum.Font.SourceSans,
    })

    local maxLabel = makeTextLabel(row, {
        Size = UDim2.new(0, 30, 0, 14),
        Position = UDim2.new(1, -30, 0, 48),
        BackgroundTransparency = 1,
        Text = tostring(max),
        TextColor3 = Colors.TextDim,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.SourceSans,
    })

    local dragging = false
    local function updateValue(inputX)
        local rel = (inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X
        rel = math.clamp(rel, 0, 1)
        local val = math.floor(rel * (max - min) + min)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -7, 0.5, -7)
        valLabel.Text = label .. ": " .. tostring(val)
        if onChange then onChange(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateValue(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateValue(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return row
end

