buildPages = function()
    local function safeBuild(name, fn)
        local ok, err = pcall(fn)
        if not ok then
            warn("[DAYI HUB] Failed to build " .. name .. " page: " .. tostring(err))
        end
    end

    safeBuild("Graphics",  buildGraphicsPage)
    safeBuild("Visual",    buildVisualPage)
    safeBuild("Player",    buildPlayerPage)
    safeBuild("Premium",   buildPremiumPage)
    safeBuild("Misc",      buildMiscPage)
    safeBuild("Configs",   buildConfigsPage)
    safeBuild("AI (WIP)",  buildAIPage)
    safeBuild("Settings",  buildSettingsPage)
    safeBuild("Changelog", buildChangelogPage)
    safeBuild("Credits",   buildCreditsPage)

    -- Show default page
    if PageFrames["Graphics"] then
        PageFrames["Graphics"].Visible = true
    end
end

rebuildHubUI = function(tabName)
    activeTab = tabName or activeTab or "Graphics"
    destroyOldGui()
    PageFrames = {}
    SidebarButtons = {}
    ConfigUI = nil
    buildGUI()
    buildPages()

    for _, page in pairs(PageFrames) do
        page.Visible = false
    end
    if PageFrames[activeTab] then
        PageFrames[activeTab].Visible = true
    elseif PageFrames["Graphics"] then
        activeTab = "Graphics"
        PageFrames["Graphics"].Visible = true
    end
end

