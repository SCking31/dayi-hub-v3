            Size = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = Colors.Purple,
            BorderSizePixel = 0,
        })
        makeUICorner(accentBar, 2)

        makeTextLabel(row, {
            Size = UDim2.new(1, -220, 0, 20),
            Position = UDim2.new(0, 14, 0, 10),
            BackgroundTransparency = 1,
            Text = slot.name,
