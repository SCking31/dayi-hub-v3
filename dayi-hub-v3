local function staggerChildren(parent, delayPerItem)
    delayPerItem = delayPerItem or 0.02
    local items = {}
    for _, child in ipairs(parent:GetChildren()) do
        if child:IsA("GuiObject") and child.Name ~= "UIGradient" and child.Name ~= "UICorner" and child.Name ~= "UIStroke" and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" and child.Name ~= "UIGridLayout" then
            local origPos = child.Position
            child.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + 8, origPos.Y.Scale, origPos.Y.Offset)
            child.Visible = false
            items[#items + 1] = {child = child, origPos = origPos}
        end
    end
    task.spawn(function()
        for _, item in ipairs(items) do
            item.child.Visible = true
            TweenService:Create(item.child, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
                Position = item.origPos,
            }):Play()
            task.wait(delayPerItem)
        end
    end)
end

