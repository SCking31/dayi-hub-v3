local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    if State.ESPObjects[player] then return end
    local espData = {}

    if Config.WallhackESP then
        espData.highlight = createHighlight(player)
        espData.box = createBoxESP(player)
    end
    if Config.SkeletonESP then
        espData.skeleton, espData.skeletonLines = createSkeletonESP(player)
    end
    if Config.BoxESP and not espData.box then
        espData.box = createBoxESP(player)
    end
    if Config.NameESP then
        espData.nameLabel = createNameESP(player)
    end

    State.ESPObjects[player] = espData
end

local function removeESPForPlayer(player)
    local espData = State.ESPObjects[player]
    if not espData then return end
    if espData.highlight then espData.highlight:Destroy() end
    if espData.box then removeBoxESP(espData.box) end
    if espData.skeleton then espData.skeleton:Destroy() end
    if espData.nameLabel then espData.nameLabel:Destroy() end
    State.ESPObjects[player] = nil
end

local function refreshAllESP()
    for player, _ in pairs(State.ESPObjects) do
        removeESPForPlayer(player)
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createESPForPlayer(player)
        end
    end
end

local function updateESP()
    for player, espData in pairs(State.ESPObjects) do
        local char = player.Character
        if not char or not isAlive(player) then
            if espData.highlight then espData.highlight.Adornee = nil end
            if espData.box then
                espData.box.box.Visible = false
                espData.box.healthBarBg.Visible = false
                espData.box.healthBarFill.Visible = false
            end
        else
            if espData.highlight then
                espData.highlight.Adornee = char
                espData.highlight.Enabled = Config.WallhackESP
            end
            if espData.box and (Config.WallhackESP or Config.BoxESP) then
                updateBoxESP(espData.box, player)
            elseif espData.box then
                espData.box.box.Visible = false
                espData.box.healthBarBg.Visible = false
                espData.box.healthBarFill.Visible = false
            end
            if espData.skeletonLines and Config.SkeletonESP then
                updateSkeletonLines(espData.skeletonLines, player)
            elseif espData.skeletonLines then
                for _, bone in ipairs(espData.skeletonLines) do
                    bone.line.Visible = false
                end
            end
            if espData.nameLabel and Config.NameESP then
                updateNameESP(espData.nameLabel, player)
            elseif espData.nameLabel then
                espData.nameLabel.Visible = false
            end
        end
    end
end

local function startESPUpdater()
    if State.ESPUpdateConnection then
        State.ESPUpdateConnection:Disconnect()
    end
    State.ESPUpdateConnection = RunService.RenderStepped:Connect(updateESP)
end

