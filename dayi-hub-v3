local function applyUnlimitedZoom()
    pcall(function()
        if Config.UnlimitedZoom then
            LocalPlayer.CameraMaxZoomDistance = 1000000
            LocalPlayer.CameraMinZoomDistance = 0.5
        else
            LocalPlayer.CameraMaxZoomDistance = State.OriginalZoomMax
            LocalPlayer.CameraMinZoomDistance = State.OriginalZoomMin
        end
    end)
end

local function applyFPSBooster()
    pcall(function()
        if Config.FPSBooster then
            if not State.FPSBackup.Done then
                State.FPSBackup.GlobalShadows = Lighting.GlobalShadows
                State.FPSBackup.FogEnd = Lighting.FogEnd
                State.FPSBackup.Materials = {}
                State.FPSBackup.Reflectance = {}
                State.FPSBackup.Particles = {}
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if v:IsA("BasePart") then
                        State.FPSBackup.Materials[v] = v.Material
                        State.FPSBackup.Reflectance[v] = v.Reflectance
                        v.Material = Enum.Material.Plastic
                        v.Reflectance = 0
                    elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                        State.FPSBackup.Particles[v] = v.Enabled
                        v.Enabled = false
                    end
                end
                State.FPSBackup.Done = true
            end
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 9e9
        else
            if State.FPSBackup.Done then
                Lighting.GlobalShadows = State.FPSBackup.GlobalShadows
                Lighting.FogEnd = State.FPSBackup.FogEnd
                for obj, mat in pairs(State.FPSBackup.Materials) do
                    pcall(function() obj.Material = mat end)
                end
                for obj, ref in pairs(State.FPSBackup.Reflectance) do
                    pcall(function() obj.Reflectance = ref end)
                end
                for obj, en in pairs(State.FPSBackup.Particles) do
                    pcall(function() obj.Enabled = en end)
                end
                table.clear(State.FPSBackup)
            end
        end
    end)
end

local function applyFPSCap(cap)
    local applied = false
    pcall(function()
        local setter = rawget(getfenv(), "setfpscap")
            or rawget(getfenv(), "set_fps_cap")
            or rawget(getfenv(), "setfpslimit")
        if typeof(setter) == "function" then
            setter(cap)
            applied = true
        end
    end)
    if not applied then
        pcall(function()
            if setfpscap then setfpscap(cap) applied = true end
        end)
    end
    return applied
end

local function applyFPSUnlocker(silent)
    local cap
    if Config.FPSUnlocker then
        local limit = tonumber(Config.FPSLimit) or 240
        if limit >= 500 then
            cap = 0 -- unlimited
        else
            cap = math.floor(limit)
        end
    else
        cap = 60
    end

    local ok = applyFPSCap(cap)
    if not silent then
        if ok then
            if Config.FPSUnlocker then
                notify("FPS Unlocker", cap == 0 and "FPS limit removed (unlimited)."
                    or ("FPS limit set to " .. cap .. "."), 3)
            else
                notify("FPS Unlocker", "Roblox default 60 FPS limit restored.", 3)
            end
        else
            notify("FPS Unlocker", "Your executor does not support FPS unlocking.", 4)
        end
    end
    return ok
end

