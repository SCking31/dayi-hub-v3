DayiHub = {}

function DayiHub.SetToggle(name, value)
    Config[name] = value
    if name == "UnlimitedZoom" then applyUnlimitedZoom()
    elseif name == "FPSBooster" then applyFPSBooster()
    elseif name == "VFXRemover" then applyVFXRemover()
    elseif name == "TextureOptimizer" then applyTextureOptimizer()
    elseif name == "ShadowRemover" then applyShadowRemover()
    elseif name == "LightOptimizer" then applyLightOptimizer()
    elseif name == "WaterOptimizer" then applyWaterOptimizer()
    elseif name == "GrassOptimizer" then applyGrassOptimizer()
    elseif name == "WallhackESP" then refreshAllESP()
    elseif name == "SkeletonESP" then refreshAllESP()
    elseif name == "Aimbot" then toggleAimbot()
    elseif name == "MobileAimbot" then toggleMobileAimbot()
    elseif name == "ShowCircle" then updateCircle()
    elseif name == "SpeedHack" then applyWalkSpeed()
    elseif name == "BunnyHop" then setupBunnyHop()
    elseif name == "FlyMode" then toggleFly()
    elseif name == "Noclip" then toggleNoclip()
    end
end

function DayiHub.SetSlider(name, value)
    Config[name] = value
    if name == "WalkSpeed" then applyWalkSpeed()
    elseif name == "CircleRadius" then updateCircle()
    end
end

function DayiHub.SetBindKey(keyName)
    Config.BindKey = keyName
    State.BindKeyDown = false
end

function DayiHub.SetUIToggleKey(keyName)
    Config.UIToggleKey = keyName
end

function DayiHub.SetAccentTheme(themeName)
    Config.AccentTheme = themeName
    applyAccentTheme(themeName)
    destroyOldGui()
    PageFrames = {}
    SidebarButtons = {}
    buildGUI()
    buildPages()
    activeTab = "Premium"
    if PageFrames["Premium"] then
        PageFrames["Premium"].Visible = true
    end
    notify("DAYI HUB", "UI color changed to " .. themeName .. ".", 3)
end

function DayiHub.SetTarget(target)
    Config.Target = target
end

getgenv().DayiHub = DayiHub

