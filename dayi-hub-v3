    local iconCircle = makeFrame(card, {
        Size = UDim2.new(0, 46, 0, 46),
        Position = sliderConfig and UDim2.new(0, 10, 0, 10) or UDim2.new(0, 10, 0.5, -23),
        BackgroundColor3 = locked and Color3.fromRGB(28, 28, 36) or Colors.PurpleDk,
    })
