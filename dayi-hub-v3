local function normalizeAIQuestion(text)
    local normalized = string.lower(tostring(text or ""))
    normalized = normalized:gsub("^%s+", ""):gsub("%s+$", "")
    normalized = normalized:gsub("^/help%s*", "")
    normalized = normalized:gsub("[%p]", " ")
    normalized = normalized:gsub("%s+", " ")
    return normalized
end

local function getAIHelpResponse(input)
    local raw = tostring(input or "")
    local trimmed = raw:gsub("^%s+", ""):gsub("%s+$", "")
    local lower = string.lower(trimmed)

    if string.sub(lower, 1, 5) ~= "/help"
        or (string.len(lower) > 5 and not string.match(lower, "^/help%s")) then
        return "Only messages that start with /help are processed. Example: /help what can you do?"
    end

    local question = normalizeAIQuestion(trimmed)
    if question == ""
        or question == "help"
        or question == "list"
        or question == "questions"
        or question == "menu" then
        return AIHelpMenu
    end

    for _, entry in ipairs(AIHelpResponses) do
        for _, keyword in ipairs(entry.keywords) do
            if string.find(question, keyword, 1, true) then
                return entry.response
            end
        end
    end

    return "I don't have an answer for that one yet. Type just /help to see the full list of questions I can answer."
end

