refreshConfigsPage = function()
    if not ConfigUI or not ConfigUI.list or not ConfigUI.list.Parent then return end

    local limit = getConfigLimit()
    local limitText
    if limit == math.huge then
        limitText = "Developer plan • Unlimited saved configs"
    else
        limitText = string.format("%s plan • %d/%d configs used", (UserPlan == "premium" and "Premium" or "Free"), #ConfigSlots, limit)
    end
    ConfigUI.limitLabel.Text = limitText

    for _, child in ipairs(ConfigUI.list:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    if #ConfigSlots == 0 then
        local empty = makeFrame(ConfigUI.list, {
            Size = UDim2.new(1, 0, 0, 62),
            BackgroundColor3 = Colors.Panel,
        })
        makeUICorner(empty, 10)
        makeUIStroke(empty, Colors.Purple, 1, 0.88)
