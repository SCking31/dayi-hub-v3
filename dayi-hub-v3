local function setupBindKey()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if Config.BindKey ~= "None" then
            local kc = keyNameToKeyCode(Config.BindKey)
            if kc and input.KeyCode == kc then
                State.BindKeyDown = true
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if Config.BindKey ~= "None" then
            local kc = keyNameToKeyCode(Config.BindKey)
            if kc and input.KeyCode == kc then
                State.BindKeyDown = false
            end
        end
    end)
end

--==========================================================================
-- UI TOGGLE KEY (RightShift)
--==========================================================================
local function setupUIToggle()
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        local kc = keyNameToKeyCode(Config.UIToggleKey)
        if kc and input.KeyCode == kc then
            State.UIVisible = not State.UIVisible
            if MainFrame and MainFrameScale then
                if State.UIVisible then
                    MainFrameScale.Scale = 0.7
                    MainFrame.Visible = true
                    MainFrame.BackgroundTransparency = 0.5
                    -- Multi-stage spring open
                    TweenService:Create(MainFrameScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.04}):Play()
                    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
                    task.delay(0.4, function()
                        TweenService:Create(MainFrameScale, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
                    end)
                else
                    -- Multi-stage close
                    TweenService:Create(MainFrameScale, TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Scale = 0.92}):Play()
                    TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {BackgroundTransparency = 0.5}):Play()
                    task.delay(0.15, function()
                        TweenService:Create(MainFrameScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0.7}):Play()
                        TweenService:Create(MainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
                    end)
                    task.delay(0.35, function()
                        MainFrame.Visible = false
                        MainFrameScale.Scale = 1
                        MainFrame.BackgroundTransparency = 0
                    end)
                end
            end
        end
    end)
end

