        {
            icon = "👋",
            title = "Welcome to DAYI HUB",
            body = "Thanks for using DAYI HUB! Let's quickly set things up. You can always change these later in the UI.",
        },
        {
            icon = "🎨",
            title = "Graphics",
            body = "Optimize your graphics for smoother gameplay. All features start disabled — enable FPS Booster or Unlimited Zoom in the Graphics tab whenever you want.",
        },
        {
            icon = "🏃",
            title = "Player",
            body = "Adjust your movement settings. Walk Speed, Jump Power, Fly, and Noclip can all be configured in the Player tab.",
        },
        {
            icon = "✅",
            title = "Finished!",
            body = "You're all set. Enjoy using DAYI HUB! Press the key shown in the status bar to toggle the menu.",
        },
    }

    local currentStep = 1

    local function updateStep()
        local s = steps[currentStep]
        iconLabel.Text = s.icon
        titleLabel.Text = s.title
        bodyLabel.Text = s.body

        -- Update dots
        for i = 1, 4 do
            if i == currentStep then
                TweenService:Create(dots[i], TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Colors.Purple}):Play()
            elseif i < currentStep then
                TweenService:Create(dots[i], TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(100, 80, 120)}):Play()
            else
                TweenService:Create(dots[i], TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
            end
        end

        -- Fade in content
        iconLabel.TextTransparency = 1
        titleLabel.TextTransparency = 1
        bodyLabel.TextTransparency = 1
        TweenService:Create(iconLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
        TweenService:Create(titleLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
        TweenService:Create(bodyLabel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()

        -- Button states
        if currentStep == 1 then
            backBtn.Visible = false
        else
            backBtn.Visible = true
        end

        if currentStep == 4 then
            nextBtn.Text = "Finish"
        else
            nextBtn.Text = "Next"
        end
    end

    backBtn.MouseButton1Click:Connect(function()
        if currentStep > 1 then
            currentStep = currentStep - 1
            updateStep()
        end
    end)

    nextBtn.MouseButton1Click:Connect(function()
        if currentStep < 4 then
            currentStep = currentStep + 1
            updateStep()
        else
            -- Finish: close onboarding, save config, proceed
            TweenService:Create(cardScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85}):Play()
            TweenService:Create(dim, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
            task.wait(0.2)
            obGui:Destroy()
            Config.FirstLaunch = false
            saveConfig()
            onComplete()
        end
    end)

    updateStep()
end

