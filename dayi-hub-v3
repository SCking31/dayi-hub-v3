        if not understood then
            -- Shake the checkbox row to indicate it needs to be checked
            local origPos = checkboxRow.Position
            TweenService:Create(checkboxRow, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + 5, origPos.Y.Scale, origPos.Y.Offset)}):Play()
            task.wait(0.05)
            TweenService:Create(checkboxRow, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Position = UDim2.new(origPos.X.Scale, origPos.X.Offset - 5, origPos.Y.Scale, origPos.Y.Offset)}):Play()
            task.wait(0.05)
            TweenService:Create(checkboxRow, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + 3, origPos.Y.Scale, origPos.Y.Offset)}):Play()
            task.wait(0.05)
            TweenService:Create(checkboxRow, TweenInfo.new(0.05, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {Position = origPos}):Play()
            -- Flash checkbox stroke
            TweenService:Create(checkboxStroke, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0, Color = Colors.Red}):Play()
            task.wait(0.15)
            TweenService:Create(checkboxStroke, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Transparency = 0.7}):Play()
            return
        end
        closeWarning()
        Config.WarningAcknowledged = true
        saveConfig()
        onAccept()
    end)
    exitBtn.MouseButton1Click:Connect(closeWarning)
end

