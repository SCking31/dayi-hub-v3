local function playSpringTween(guiObject, props, stiffness, damping)
    local style = Enum.EasingStyle.Back
    local dir = Enum.EasingDirection.Out
    if stiffness == "soft" then
        style = Enum.EasingStyle.Quad
        dir = Enum.EasingDirection.Out
    elseif stiffness == "elastic" then
        style = Enum.EasingStyle.Back
        dir = Enum.EasingDirection.Out
    elseif stiffness == "snappy" then
        style = Enum.EasingStyle.Quint
        dir = Enum.EasingDirection.Out
    elseif stiffness == "bounce" then
        style = Enum.EasingStyle.Bounce
        dir = Enum.EasingDirection.Out
    end
    local duration = damping or 0.35
    TweenService:Create(guiObject, TweenInfo.new(duration, style, dir), props):Play()
end

local function playRipple(parent, x, y, color)
    local ripple = makeFrame(parent, {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, x, 0, y),
        BackgroundColor3 = color or Colors.White,
        BackgroundTransparency = 0.6,
        BorderSizePixel = 0,
        ZIndex = 5,
    })
    makeUICorner(ripple, 100)
    TweenService:Create(ripple, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 300, 0, 300),
        Position = UDim2.new(0, x - 150, 0, y - 150),
        BackgroundTransparency = 1,
    }):Play()
    task.delay(0.5, function() ripple:Destroy() end)
end

local function addHoverLift(guiObject, liftAmount, scaleAmount)
    liftAmount = liftAmount or -2
    scaleAmount = scaleAmount or 1.02
    local origPos = guiObject.Position
    guiObject.MouseEnter:Connect(function()
        playSpringTween(guiObject, {
            Position = UDim2.new(origPos.X.Scale, origPos.X.Offset, origPos.Y.Scale, origPos.Y.Offset + liftAmount),
        }, "elastic", 0.25)
    end)
    guiObject.MouseLeave:Connect(function()
        playSpringTween(guiObject, {
            Position = origPos,
        }, "elastic", 0.25)
    end)
end

local function addGlowPulse(guiObject, baseTransparency, pulseAmount, speed)
    baseTransparency = baseTransparency or 0.9
    pulseAmount = pulseAmount or 0.05
    speed = speed or 2
    task.spawn(function()
        local t = 0
        while guiObject and guiObject.Parent do
            t = t + RunService.RenderStepped:Wait()
            guiObject.BackgroundTransparency = baseTransparency + math.sin(t * speed) * pulseAmount
        end
    end)
end

local function addFloatAnim(guiObject, amplitude, speed, offset)
    amplitude = amplitude or 3
    speed = speed or 1.5
    offset = offset or 0
    local origY = guiObject.Position.Y.Offset
    task.spawn(function()
        local t = offset
        while guiObject and guiObject.Parent do
            t = t + RunService.RenderStepped:Wait()
            guiObject.Position = UDim2.new(
                guiObject.Position.X.Scale, guiObject.Position.X.Offset,
                guiObject.Position.Y.Scale, origY + math.sin(t * speed) * amplitude
            )
        end
    end)
end

