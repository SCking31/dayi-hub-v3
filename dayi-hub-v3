        BackgroundColor3 = Colors.Panel,
    })
    makeUICorner(iconCircle, 19)
    makeUIStroke(iconCircle, accentColor, 1, 0.55)
    makeUIGradient(iconCircle, Color3.fromRGB(18, 16, 28), Color3.fromRGB(12, 10, 20), 135)

    makeTextLabel(iconCircle, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = iconText,
        TextColor3 = Colors.Text,
        TextSize = 17,
        Font = Enum.Font.SourceSansBold,
    })

    local valLabel = makeTextLabel(row, {
        Size = UDim2.new(1, -30, 0, 20),
        Position = UDim2.new(0, 64, 0, 10),
        BackgroundTransparency = 1,
        Text = label .. ": " .. tostring(defaultVal),
        TextColor3 = Colors.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansBold,
    })

    local track = makeFrame(row, {
        Size = UDim2.new(1, -120, 0, 6),
        Position = UDim2.new(0, 64, 0, 48),
        BackgroundColor3 = Color3.fromRGB(35, 35, 50),
        Active = true,
    })
    makeUICorner(track, 3)

    local fill = makeFrame(track, {
        Size = UDim2.new((defaultVal - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = accentColor,
    })
    makeUICorner(fill, 3)
    makeUIGradient(fill, accentColor, Color3.fromRGB(accentColor.R * 220, accentColor.G * 220, accentColor.B * 220), 90)

    local knob = makeFrame(track, {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new((defaultVal - min) / (max - min), -7, 0.5, -7),
        BackgroundColor3 = Colors.White,
    })
    makeUICorner(knob, 7)
    makeUIStroke(knob, accentColor, 2, 0)

    local minLabel = makeTextLabel(row, {
        Size = UDim2.new(0, 20, 0, 14),
        Position = UDim2.new(0, 50, 0, 48),
        BackgroundTransparency = 1,
        Text = tostring(min),
        TextColor3 = Colors.TextDim,
        TextSize = 10,
        Font = Enum.Font.SourceSans,
    })

    local maxLabel = makeTextLabel(row, {
        Size = UDim2.new(0, 30, 0, 14),
        Position = UDim2.new(1, -30, 0, 48),
        BackgroundTransparency = 1,
        Text = tostring(max),
        TextColor3 = Colors.TextDim,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.SourceSans,
    })

    local dragging = false
    local decimalPlaces = 0
    local function countDecimalPlaces(value)
        local text = tostring(value)
        local dot = string.find(text, "%.")
        return dot and (#text - dot) or 0
    end
    decimalPlaces = math.max(countDecimalPlaces(min), countDecimalPlaces(max))

    local function updateValue(inputX)
        local rel = (inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X
        rel = math.clamp(rel, 0, 1)
        local rawValue = rel * (max - min) + min
        local factor = 10 ^ decimalPlaces
        local val = math.floor(rawValue * factor + 0.5) / factor
        local normalized = math.clamp((val - min) / (max - min), 0, 1)
        fill.Size = UDim2.new(normalized, 0, 1, 0)
        knob.Position = UDim2.new(normalized, -7, 0.5, -7)
        valLabel.Text = label .. ": " .. tostring(val)
        if onChange then onChange(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateValue(input.Position.X)
            -- Knob scale punch on grab
            playSpringTween(knob, {Size = UDim2.new(0, 20, 0, 20)}, "elastic", 0.15)
            playSpringTween(knob, {BackgroundTransparency = 0}, "snappy", 0.1)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            -- Knob scale release
            playSpringTween(knob, {Size = UDim2.new(0, 14, 0, 14)}, "elastic", 0.3)
        end
    end)

    addRowHover(row, accentColor)
    return row
end

