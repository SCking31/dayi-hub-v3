        grid.CellPadding = UDim2.new(0, 6, 0, 0)
        grid.SortOrder = Enum.SortOrder.LayoutOrder
        grid.Parent = rowHolder

        for featureIndex = i, math.min(i + 1, #features) do
            local f = features[featureIndex]
            local effectiveLocked = f.locked and not isPremiumUser()
            local sliderConfig = nil
            if f.key == "FPSUnlocker" then
                sliderConfig = {
                    label = "FPS Limit",
