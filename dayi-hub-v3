--==========================================================================
-- LIVE FPS TRACKER (counts real rendered frames)
--==========================================================================
local FPSTracker = { current = 0 }
do
    local frames = 0
    local elapsed = 0
    RunService.RenderStepped:Connect(function(dt)
        frames = frames + 1
        elapsed = elapsed + dt
        if elapsed >= 0.5 then
            FPSTracker.current = math.floor((frames / elapsed) + 0.5)
            frames = 0
            elapsed = 0
        end
    end)
end

local function applyMobileUIScale(guiObject, centerOnMobile)
    if MobileUIScale == 1 then return end
    if centerOnMobile then
        guiObject.AnchorPoint = Vector2.new(0.5, 0.5)
        guiObject.Position = UDim2.new(0.5, 0, 0.5, 0)
    end
    local scale = Instance.new("UIScale")
    scale.Name = "DAYI_MobileUIScale"
    scale.Scale = MobileUIScale
    scale.Parent = guiObject
    return scale
end

