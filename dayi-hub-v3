        local fpsAccum = 0
        while true do
            local dt = RunService.RenderStepped:Wait()
            if dt > 0 then
                fpsAccum = fpsAccum + (1 / dt)
                fpsFrames = fpsFrames + 1
            end
            if fpsFrames >= 30 then
                local avgFps = math.floor(fpsAccum / fpsFrames)
