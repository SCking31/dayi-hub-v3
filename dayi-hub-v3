        frame.Size = UDim2.new(0, radius * 2, 0, radius * 2)
        frame.Position = UDim2.new(0.5, -radius, 0.5, -radius)
        if CircleStroke then
            CircleStroke.Color = Config.CircleColor or Color3.fromRGB(0, 220, 220)
        end
        frame.Visible = true
