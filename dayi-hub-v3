            elseif child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Transparency = 1}):Play()
            end
        end
        task.wait(0.35)
        warnGui:Destroy()
        if onClose then
            onClose()
        end
    end

    closeBtn.MouseButton1Click:Connect(closeWarning)
