local function addHoverLift(guiObject, liftAmount, scaleAmount)
    liftAmount = liftAmount or -2
    scaleAmount = scaleAmount or 1.02
    local origPos = guiObject.Position
    guiObject.MouseEnter:Connect(function()
        playSpringTween(guiObject, {
            Position = UDim2.new(origPos.X.Scale, origPos.X.Offset, origPos.Y.Scale, origPos.Y.Offset + liftAmount),
        }, "elastic", 0.25)
    end)
    guiObject.MouseLeave:Connect(function()
        playSpringTween(guiObject, {
            Position = origPos,
        }, "elastic", 0.25)
    end)
end

local function playRepeatingTween(guiObject, tweenInfo, props)
    if not guiObject or not guiObject.Parent then return nil end
    local tween = TweenService:Create(guiObject, tweenInfo, props)
    local ancestryConnection
    ancestryConnection = guiObject.AncestryChanged:Connect(function(_, parent)
        if not parent then
            pcall(function() tween:Cancel() end)
            if ancestryConnection then
                ancestryConnection:Disconnect()
                ancestryConnection = nil
            end
        end
    end)
    tween:Play()
    return tween
end

local function addGlowPulse(guiObject, baseTransparency, pulseAmount, speed)
    baseTransparency = baseTransparency or 0.9
    pulseAmount = pulseAmount or 0.05
    speed = speed or 2
    local period = 1 / speed
    guiObject.BackgroundTransparency = baseTransparency
    return playRepeatingTween(
        guiObject,
        TweenInfo.new(period, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        {BackgroundTransparency = baseTransparency - pulseAmount}
    )
end

local function addFloatAnim(guiObject, amplitude, speed, offset)
    amplitude = amplitude or 3
    speed = speed or 1.5
    offset = offset or 0
    local origY = guiObject.Position.Y.Offset
    local period = 1 / speed
    task.delay(offset / speed, function()
        if not guiObject or not guiObject.Parent then return end
        playRepeatingTween(
            guiObject,
            TweenInfo.new(period, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            {Position = UDim2.new(guiObject.Position.X.Scale, guiObject.Position.X.Offset, guiObject.Position.Y.Scale, origY - amplitude)}
        )
    end)
end

local function addRippleClick(button, color)
