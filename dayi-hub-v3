    if locked then
        makeUIGradient(iconCircle, Color3.fromRGB(32, 30, 42), Color3.fromRGB(24, 22, 32), 135)
        makeUIStroke(iconCircle, Colors.Purple, 1, 0.85)
    else
        makeUIGradient(iconCircle, Color3.fromRGB(80, 30, 160), Color3.fromRGB(50, 18, 100), 135)
        makeUIStroke(iconCircle, Colors.PurpleBright, 1, 0.3)
    end

    makeTextLabel(iconCircle, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = locked and "🔒" or iconText,
        TextColor3 = Colors.Text,
        TextSize = locked and 18 or 20,
        Font = Enum.Font.SourceSansBold,
    })

    local nameText = makeTextLabel(card, {
        Size = UDim2.new(1, -130, 0, 18),
        Position = UDim2.new(0, 66, 0, sliderConfig and 12 or 20),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = locked and Colors.TextFaint or Colors.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = Enum.Font.SourceSansBold,
    })

    local descText = makeTextLabel(card, {
        Size = UDim2.new(1, -130, 0, 14),
        Position = UDim2.new(0, 66, 0, sliderConfig and 34 or 42),
        BackgroundTransparency = 1,
        Text = locked and "Premium required" or desc,
        TextColor3 = locked and Colors.TextFaint or Colors.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Font = Enum.Font.SourceSans,
    })

    if locked then
        local badge = makeFrame(card, {
            Size = UDim2.new(0, 60, 0, 22),
            Position = UDim2.new(1, -72, 0.5, -11),
            BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        })
        makeUICorner(badge, 11)
        makeUIGradient(badge, Color3.fromRGB(36, 34, 48), Color3.fromRGB(24, 22, 34), 135)
        makeUIStroke(badge, Colors.Purple, 1, 0.85)
        makeTextLabel(badge, {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "🔒 Soon",
            TextColor3 = Colors.TextFaint,
            TextSize = 10,
            Font = Enum.Font.SourceSansBold,
        })
    else
        local toggle = createToggle(card, defaultOn, onChange)
        toggle.Position = sliderConfig and UDim2.new(1, -58, 0, 17) or UDim2.new(1, -58, 0.5, -12)
    end

    if sliderConfig and not locked then
        local min = sliderConfig.min
        local max = sliderConfig.max
        local current = math.clamp(sliderConfig.defaultVal, min, max)
        local normalized = (current - min) / (max - min)

        local valueLabel = makeTextLabel(card, {
            Size = UDim2.new(1, -82, 0, 16),
            Position = UDim2.new(0, 66, 0, 66),
            BackgroundTransparency = 1,
            Text = sliderConfig.label .. ": " .. tostring(current),
            TextColor3 = Colors.Text,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSansBold,
        })

        local track = makeFrame(card, {
            Size = UDim2.new(1, -96, 0, 6),
            Position = UDim2.new(0, 66, 0, 94),
            BackgroundColor3 = Color3.fromRGB(35, 35, 50),
            Active = true,
        })
        makeUICorner(track, 3)

        local fill = makeFrame(track, {
            Size = UDim2.new(normalized, 0, 1, 0),
            BackgroundColor3 = sliderConfig.accentColor,
        })
        makeUICorner(fill, 3)
        makeUIGradient(fill, sliderConfig.accentColor, Color3.fromRGB(sliderConfig.accentColor.R * 220, sliderConfig.accentColor.G * 220, sliderConfig.accentColor.B * 220), 90)

        local knob = makeFrame(track, {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(normalized, -7, 0.5, -7),
            BackgroundColor3 = Colors.White,
        })
        makeUICorner(knob, 7)
        makeUIStroke(knob, sliderConfig.accentColor, 2, 0)

        makeTextLabel(card, {
            Size = UDim2.new(0, 32, 0, 14),
            Position = UDim2.new(0, 66, 0, 104),
            BackgroundTransparency = 1,
            Text = tostring(min),
            TextColor3 = Colors.TextDim,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSans,
        })
        makeTextLabel(card, {
            Size = UDim2.new(0, 36, 0, 14),
            Position = UDim2.new(1, -66, 0, 104),
            BackgroundTransparency = 1,
            Text = tostring(max),
            TextColor3 = Colors.TextDim,
            TextSize = 9,
            TextXAlignment = Enum.TextXAlignment.Right,
            Font = Enum.Font.SourceSans,
        })

        local dragging = false
        local function updateSlider(inputX)
            local relative = (inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X
            relative = math.clamp(relative, 0, 1)
            local value = math.floor(relative * (max - min) + min + 0.5)
            local position = (value - min) / (max - min)
            fill.Size = UDim2.new(position, 0, 1, 0)
            knob.Position = UDim2.new(position, -7, 0.5, -7)
            valueLabel.Text = sliderConfig.label .. ": " .. tostring(value)
            if sliderConfig.onChange then sliderConfig.onChange(value) end
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateSlider(input.Position.X)
                playSpringTween(knob, {Size = UDim2.new(0, 20, 0, 20)}, "elastic", 0.15)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
                playSpringTween(knob, {Size = UDim2.new(0, 14, 0, 14)}, "elastic", 0.3)
            end
        end)
    end

    -- Feature card hover lift
    if not locked then
        addHoverLift(card, -3, 1.01)
        card.MouseEnter:Connect(function()
            playSpringTween(card, {BackgroundColor3 = Color3.fromRGB(28, 26, 42)}, "soft", 0.2)
        end)
        card.MouseLeave:Connect(function()
            playSpringTween(card, {BackgroundColor3 = Colors.Card}, "soft", 0.2)
        end)
    end

    return card
end

