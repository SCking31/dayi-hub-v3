local function createHighlight(player)
    local hl = Instance.new("Highlight")
    hl.Name = "DAYI_ESP_HL_" .. player.Name
    hl.FillColor = Config.ESPColor or Color3.fromRGB(255, 0, 0)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.7
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = player.Character
    hl.Enabled = Config.WallhackESP
    hl.Parent = CoreGui
    return hl
end

local function createSkeletonESP(player)
    local char = player.Character
    if not char then return nil, nil end

    local folder = Instance.new("Folder")
    folder.Name = "DAYI_ESP_Skel_" .. player.Name
    folder.Parent = CoreGui

    local bones = {
        {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
        {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
        {"LeftLowerArm", "LeftHand"},
        {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"},
        {"RightLowerArm", "RightHand"},
        {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
        {"LeftLowerLeg", "LeftFoot"},
        {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"},
        {"RightLowerLeg", "RightFoot"},
    }

    local lines = {}
    for _, b in ipairs(bones) do
        local p1 = char:FindFirstChild(b[1])
        local p2 = char:FindFirstChild(b[2])
        if p1 and p2 then
            local line = Instance.new("Frame")
            line.Name = "Bone_" .. b[1] .. "_" .. b[2]
            line.BackgroundColor3 = Config.ESPColor or Color3.fromRGB(255, 0, 0)
            line.BorderSizePixel = 0
            line.Size = UDim2.new(0, 1, 0, 1)
            line.Parent = folder
            table.insert(lines, { line = line, p1 = p1, p2 = p2 })
        end
    end
    return folder, lines
end

local function updateSkeletonLines(lines)
    if not lines then return end
    for _, bone in ipairs(lines) do
        if bone.line.Parent then
            local pos1, vis1 = Camera:WorldToViewportPoint(bone.p1.Position)
            local pos2, vis2 = Camera:WorldToViewportPoint(bone.p2.Position)
            if vis1 and vis2 then
                bone.line.Visible = true
                local dist = (Vector2.new(pos1.X, pos1.Y) - Vector2.new(pos2.X, pos2.Y)).Magnitude
                local angle = math.atan2(pos2.Y - pos1.Y, pos2.X - pos1.X)
                bone.line.Size = UDim2.new(0, dist, 0, 2)
                bone.line.Position = UDim2.new(0, pos1.X, 0, pos1.Y)
                bone.line.Rotation = math.deg(angle)
            else
                bone.line.Visible = false
            end
        end
    end
end

local function createESPForPlayer(player)
    if player == LocalPlayer then return end
    if State.ESPObjects[player] then return end
    local espData = {}

    if Config.WallhackESP then espData.highlight = createHighlight(player) end
    if Config.SkeletonESP then espData.skeleton, espData.skeletonLines = createSkeletonESP(player) end

    State.ESPObjects[player] = espData
end

local function removeESPForPlayer(player)
    local espData = State.ESPObjects[player]
    if not espData then return end
    if espData.highlight then espData.highlight:Destroy() end
    if espData.skeleton then espData.skeleton:Destroy() end
    State.ESPObjects[player] = nil
end

local function refreshAllESP()
    for player, _ in pairs(State.ESPObjects) do
        removeESPForPlayer(player)
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            createESPForPlayer(player)
        end
    end
end

local function updateESP()
    for player, espData in pairs(State.ESPObjects) do
        local char = player.Character
        if not char or not isAlive(player) then
            if espData.highlight then espData.highlight.Adornee = nil end
        else
            if espData.highlight then
                espData.highlight.Adornee = char
                espData.highlight.Enabled = Config.WallhackESP
            end
            if espData.skeletonLines then
                updateSkeletonLines(espData.skeletonLines)
            end
        end
    end
end

local function startESPUpdater()
    if State.ESPUpdateConnection then
        State.ESPUpdateConnection:Disconnect()
    end
    State.ESPUpdateConnection = RunService.RenderStepped:Connect(updateESP)
end

--==========================================================================
-- AIMBOT
--==========================================================================
local function getClosestPlayer()
    local closest, closestDist = nil, Config.CircleRadius
    local viewportSize = Camera.ViewportSize
    local center = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) and not isSameTeam(player) then
            local targetPart = getTargetPart(player)
            if targetPart then
                if not (Config.VisibilityCheck and isBehindWall(targetPart)) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                        if Config.FOVCheck then
                            if dist <= Config.CircleRadius and dist < closestDist then
                                closestDist = dist
                                closest = player
                            end
                        else
                            if dist < closestDist then
                                closestDist = dist
                                closest = player
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function aimbotStep()
    if not Config.Aimbot then return end
    if Config.BindKey ~= "None" and not State.BindKeyDown then return end

    local target = getClosestPlayer()
    if target then
        local targetPart = getTargetPart(target)
        if targetPart then
            local currentCF = Camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPart.Position)
            if Config.AimbotSmoothness > 0 and Config.AimbotSmoothness < 1 then
                Camera.CFrame = currentCF:Lerp(targetCF, 1 - Config.AimbotSmoothness)
            else
                Camera.CFrame = targetCF
            end
        end
    end
end

local function toggleAimbot()
    if State.AimbotConnection then
        State.AimbotConnection:Disconnect()
        State.AimbotConnection = nil
    end
    if Config.Aimbot then
        State.AimbotConnection = RunService.RenderStepped:Connect(aimbotStep)
    end
end

