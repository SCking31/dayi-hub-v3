local function init()
    -- Read plan from key system
    if _G.DAYI_HUB_PLAN then
        UserPlan = _G.DAYI_HUB_PLAN
    end

    loadConfig()

    -- Force all features OFF on startup; user enables what they want
    for _, k in ipairs({
        "UnlimitedZoom", "FPSBooster", "VFXRemover", "TextureOptimizer",
        "ShadowRemover", "LightOptimizer", "WaterOptimizer", "GrassOptimizer",
        "WallhackESP", "SkeletonESP", "BoxESP", "NameESP",
        "Aimbot", "MobileAimbot", "ShowCircle",
        "SpeedHack", "BunnyHop", "FlyMode", "Noclip", "InfiniteJump",
        "AntiRagdoll", "GodMode",
        "FOVCheck", "TeamCheck", "VisibilityCheck", "RGBAccent",
    }) do
        Config[k] = false
    end
    Config.CameraFOV = 70
    Config.ParticleLevel = 60
    Config.RGBSpeed = 0.003

    State.OriginalZoomMax = LocalPlayer.CameraMaxZoomDistance
    State.OriginalZoomMin = LocalPlayer.CameraMinZoomDistance
    local hum = getHumanoid(LocalPlayer)
    if hum then
        State.OriginalWalkSpeed = hum.WalkSpeed
        State.OriginalJumpPower = hum.JumpPower
    end

    local function buildMainUI()
        buildGUI()
        buildPages()

        if MainFrameScale then
            MainFrameScale.Scale = 0.85
            TweenService:Create(MainFrameScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end

        -- Apply defaults
        applyUnlimitedZoom()
        applyFPSBooster()
        refreshAllESP()
        startESPUpdater()
        toggleAimbot()
        toggleMobileAimbot()
        updateCircle()
        startCircleUpdater()
        applyWalkSpeed()
        applyCameraFOV()
        setupBunnyHop()
        setupInfiniteJump()
        applyJumpPower()
        toggleFly()
        toggleNoclip()
        setupBindKey()
        setupUIToggle()
        setupPlayerEvents()

        if LocalPlayer.Character then
            onCharacterAdded(LocalPlayer.Character)
        end
        LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

        Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            Camera = Workspace.CurrentCamera
        end)

        applyAccentTheme(Config.AccentTheme)
        local planInfo = PlanDisplay[UserPlan] or PlanDisplay.free
        notify("DAYI HUB v10.2", "Loaded (" .. planInfo.label .. ")! Press " .. Config.UIToggleKey .. " to toggle UI.", 4)
        task.delay(2, function()
            notify("Don't forget to join Discord server", "discord.gg/QFwWBWM2j", 6)
        end)
        print("[DAYI HUB] v10.2 loaded. Press " .. Config.UIToggleKey .. " to toggle UI.")
        print("[DAYI HUB] Discord: discord.gg/QFwWBWM2j")
    end

    -- Show warning UI first, then loading screen, then onboarding (if first launch) or main UI
    showWarningUI(function()
        showLoadingScreen(function()
            if Config.FirstLaunch then
                showOnboarding(buildMainUI)
            else
                buildMainUI()
                -- Returning user: show animated welcome-back notification (UI stays open)
                task.delay(0.5, function()
                    showWelcomeBackNotification()
                end)
            end
        end)
    end)
end

init()
