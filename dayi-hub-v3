local function setupBunnyHop()
    if State.BunnyHopConnection then
        State.BunnyHopConnection:Disconnect()
        State.BunnyHopConnection = nil
    end
    local hum = getHumanoid(LocalPlayer)
    if hum and State.OriginalWalkSpeed then
        hum.WalkSpeed = State.OriginalWalkSpeed
    end
    if Config.BunnyHop then
        State.BunnyHopConnection = RunService.Heartbeat:Connect(function()
            local hum = getHumanoid(LocalPlayer)
            if not hum or hum.Health <= 0 then return end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                local state = hum:GetState()
                if state == Enum.HumanoidStateType.Running
                or state == Enum.HumanoidStateType.Landed
                or state == Enum.HumanoidStateType.PlatformStanding
                or state == Enum.HumanoidStateType.Climbing then
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end
        end)
    end
end

local function setupAutoJump()
    if State.AutoJumpConnection then
        State.AutoJumpConnection:Disconnect()
        State.AutoJumpConnection = nil
    end
    if not Config.AutoJump then return end

    local hum = getHumanoid(LocalPlayer)
    if not hum then return end

    local lastJumpAt = 0
    local function jumpIfGrounded()
        if not Config.AutoJump or hum.Health <= 0 or not hum.Parent then return end
        if os.clock() - lastJumpAt < 0.18 then return end

        local state = hum:GetState()
        if (state == Enum.HumanoidStateType.Landed
            or state == Enum.HumanoidStateType.Running)
            and hum.FloorMaterial ~= Enum.Material.Air then
            lastJumpAt = os.clock()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end

    State.AutoJumpConnection = hum.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Landed
            or newState == Enum.HumanoidStateType.Running then
            task.defer(jumpIfGrounded)
        end
    end)

    task.defer(jumpIfGrounded)
end

local function setupInfiniteJump()
    if State.InfiniteJumpConn then
        State.InfiniteJumpConn:Disconnect()
        State.InfiniteJumpConn = nil
    end
    if Config.InfiniteJump then
        State.InfiniteJumpConn = UserInputService.JumpRequest:Connect(function()
            local hum = getHumanoid(LocalPlayer)
            if hum and hum.Health > 0 then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
