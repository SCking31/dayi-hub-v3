    end)

    local closed = false
    local function closeWarning()
        if closed then return end
        closed = true
        killAnims()
        TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0.7}):Play()
