    makeUIStroke(card, Colors.Purple, 1.5, 0)

    local cardScale = Instance.new("UIScale")
    cardScale.Scale = 0.85
    cardScale.Parent = card
    TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    -- Title
    makeTextLabel(card, {
        Size = UDim2.new(1, -40, 0, 28),
        Position = UDim2.new(0, 20, 0, 24),
        BackgroundTransparency = 1,
        Text = "Loading Modules...",
        TextColor3 = Colors.Text,
        TextSize = 20,
        TextXAlignment = Enum.TextXAlignment.Left,
        Font = Enum.Font.SourceSansBold,
    })

    -- Progress bar background
    local barBg = makeFrame(card, {
        Size = UDim2.new(1, -40, 0, 22),
        Position = UDim2.new(0, 20, 0, 64),
        BackgroundColor3 = Color3.fromRGB(30, 30, 40),
        BorderSizePixel = 0,
    })
    makeUICorner(barBg, 6)

    -- Progress bar fill
    local barFill = makeFrame(barBg, {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Colors.Purple,
        BorderSizePixel = 0,
    })
    makeUICorner(barFill, 6)

    -- Progress percentage text
    local pctLabel = makeTextLabel(card, {
        Size = UDim2.new(1, -40, 0, 16),
        Position = UDim2.new(0, 20, 0, 92),
        BackgroundTransparency = 1,
        Text = "0%",
        TextColor3 = Colors.TextDim,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
        Font = Enum.Font.SourceSans,
    })

    -- Module list
    local modules = {
        {name = "Graphics",      icon = "🎨"},
        {name = "Visual",        icon = "👁"},
        {name = "Player",        icon = "🏃"},
        {name = "Settings",      icon = "⚙"},
        {name = "Premium",       icon = "👑"},
        {name = "Notifications", icon = "🔔"},
    }

    local listStartY = 124
    local rowH = 30
    local moduleLabels = {}

    for i, mod in ipairs(modules) do
        local row = makeFrame(card, {
            Size = UDim2.new(1, -40, 0, rowH),
            Position = UDim2.new(0, 20, 0, listStartY + (i - 1) * rowH),
            BackgroundTransparency = 1,
        })

        makeTextLabel(row, {
            Size = UDim2.new(0, 24, 1, 0),
            BackgroundTransparency = 1,
            Text = mod.icon,
            TextColor3 = Colors.TextDim,
            TextSize = 16,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSansBold,
        })

        makeTextLabel(row, {
            Size = UDim2.new(1, -60, 1, 0),
            Position = UDim2.new(0, 28, 0, 0),
            BackgroundTransparency = 1,
            Text = mod.name,
            TextColor3 = Colors.TextDim,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Left,
            Font = Enum.Font.SourceSans,
        })

        local statusLabel = makeTextLabel(row, {
            Size = UDim2.new(0, 40, 1, 0),
            Position = UDim2.new(1, -40, 0, 0),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = Colors.TextDim,
            TextSize = 15,
            TextXAlignment = Enum.TextXAlignment.Right,
            Font = Enum.Font.SourceSansBold,
        })

        moduleLabels[i] = {row = row, status = statusLabel, name = mod.name}
    end

    -- Animate progress
    local totalSteps = #modules
    local stepDuration = 0.35

    task.spawn(function()
        for i = 1, totalSteps do
            local pct = math.floor((i / totalSteps) * 100)

            -- Animate bar fill
            TweenService:Create(barFill, TweenInfo.new(stepDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(i / totalSteps, 0, 1, 0)}):Play()
            pctLabel.Text = pct .. "%"

            -- Mark module as loaded with checkmark
            local ml = moduleLabels[i]
            ml.status.Text = "✔"
            TweenService:Create(ml.status, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextColor3 = Color3.fromRGB(100, 220, 130)}):Play()

            task.wait(stepDuration)
        end

        -- Final 100%
        pctLabel.Text = "100%"
        task.wait(0.4)

        -- Fade out
        TweenService:Create(cardScale, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85}):Play()
        TweenService:Create(dim, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
        task.wait(0.3)
        loadGui:Destroy()
        if onComplete then onComplete() end
    end)
end

