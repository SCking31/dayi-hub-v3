--==== HELPERS ====--
local function makeFrame(parent, props)
    local f = Instance.new("Frame")
    f.Parent = parent
    for k, v in pairs(props) do f[k] = v end
    return f
end

local function makeTextLabel(parent, props)
    local l = Instance.new("TextLabel")
    l.Parent = parent
    l.BackgroundTransparency = 1
    for k, v in pairs(props) do l[k] = v end
    return l
end

local function makeTextBox(parent, props)
    local tb = Instance.new("TextBox")
    tb.Parent = parent
    tb.BackgroundTransparency = 1
    tb.ClearTextOnFocus = false
    for k, v in pairs(props) do tb[k] = v end
    return tb
end

local function makeButton(parent, props)
    local b = Instance.new("TextButton")
    b.Parent = parent
    b.AutoButtonColor = false
    for k, v in pairs(props) do b[k] = v end
    return b
end

local function makeUICorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function makeUIStroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or C.Border
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.87
    s.Parent = parent
    return s
end

local function makeUIGradient(parent, colorSeq, rot)
    local g = Instance.new("UIGradient")
    g.Color = colorSeq
    g.Rotation = rot or 0
    g.Parent = parent
    return g
end

--==== AURORA BACKGROUND ====--
local function createAurora(parent)
    local auroraFolder = makeFrame(parent, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 1,
    })

    local colors = { C.Purple, C.Pink, C.Cyan, C.PurpleBtn }
    for i = 1, 4 do
        local orb = makeFrame(auroraFolder, {
            Size = UDim2.new(0, 300, 0, 300),
            Position = UDim2.new(math.random(), -150, math.random(), -150),
            BackgroundColor3 = colors[i],
            BackgroundTransparency = 0.85,
            ZIndex = 1,
        })
        makeUICorner(orb, 150)

        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, colors[i]),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 0)),
        })
        gradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(1, 1),
        })
        gradient.Parent = orb

        local scale = Instance.new("UIScale")
        scale.Scale = 1
        scale.Parent = orb

        local info = {
            frame = orb,
            scale = scale,
            phase = math.random() * math.pi * 2,
            speed = 0.003 + math.random() * 0.004,
            driftX = (math.random() - 0.5) * 0.0008,
            driftY = (math.random() - 0.5) * 0.0008,
            x = orb.Position.X.Scale,
            y = orb.Position.Y.Scale,
        }

        RunService.RenderStepped:Connect(function()
            info.phase = info.phase + info.speed
            info.x = info.x + info.driftX
            info.y = info.y + info.driftY
            if info.x > 1.3 then info.x = -0.3 end
            if info.x < -0.3 then info.x = 1.3 end
            if info.y > 1.3 then info.y = -0.3 end
            if info.y < -0.3 then info.y = 1.3 end
            info.frame.Position = UDim2.new(info.x, -150, info.y, -150)
            info.scale.Scale = 1 + math.sin(info.phase) * 0.3
            orb.BackgroundTransparency = 0.82 + math.sin(info.phase * 0.7) * 0.08
        end)
    end
end

--==== FLOATING PARTICLES ====--
local function createParticles(parent, count)
    count = count or 20
    local particles = {}
    for i = 1, count do
        local p = Instance.new("Frame")
        p.Name = "Particle" .. i
        local hue = math.random()
        if hue < 0.5 then
            p.BackgroundColor3 = C.Purple
        elseif hue < 0.8 then
            p.BackgroundColor3 = C.Pink
        else
            p.BackgroundColor3 = C.Cyan
        end
        p.BackgroundTransparency = 0.7 + math.random() * 0.25
        p.Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5))
        p.Position = UDim2.new(math.random(), 0, math.random(), 0)
        p.BorderSizePixel = 0
        p.ZIndex = 2
        p.Parent = parent
        makeUICorner(p, 3)

        local info = {
            x = math.random(),
            y = math.random(),
            speed = 0.0006 + math.random() * 0.0014,
            drift = (math.random() - 0.5) * 0.0006,
            phase = math.random() * math.pi * 2,
            frame = p,
        }
        particles[#particles + 1] = info
    end

    RunService.RenderStepped:Connect(function()
        for _, info in ipairs(particles) do
            info.phase = info.phase + info.speed
            info.y = info.y - info.speed * 0.4
            info.x = info.x + math.sin(info.phase) * info.drift
            if info.y < -0.05 then
                info.y = 1.05
                info.x = math.random()
            end
            info.frame.Position = UDim2.new(info.x, 0, info.y, 0)
        end
    end)
end

--==== ROTATING CONIC GRADIENT BORDER ====--
local function createConicBorder(parent, thickness)
    local container = makeFrame(parent, {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 4,
    })

    local segments = 36
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 0
    stroke.Transparency = 1
    stroke.Parent = container

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,    C.Purple),
        ColorSequenceKeypoint.new(0.25, C.Pink),
        ColorSequenceKeypoint.new(0.5,  C.Cyan),
        ColorSequenceKeypoint.new(0.75, C.Purple),
        ColorSequenceKeypoint.new(1,    C.PurpleBtn),
    })
    grad.Parent = stroke

    local rotation = 0
    RunService.RenderStepped:Connect(function()
        rotation = (rotation + 1.5) % 360
        grad.Rotation = rotation
        stroke.Thickness = thickness or 2
        stroke.Transparency = 0.1
    end)

    return container, stroke
end

--==== GLOW PULSE ====--
local function startGlowPulse(stroke)
    local t = 0
    RunService.RenderStepped:Connect(function()
        t = t + 0.025
        stroke.Transparency = 0.1 + math.sin(t) * 0.15
    end)
end

--==== SHIMMER EFFECT ====--
local function createShimmer(parent)
    local shimmer = makeFrame(parent, {
        Size = UDim2.new(0, 80, 1, 0),
        Position = UDim2.new(0, -80, 0, 0),
        BackgroundColor3 = C.White,
        BackgroundTransparency = 0.85,
        ZIndex = 9,
    })
    makeUICorner(shimmer, 10)
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(255, 255, 255)),
    })
    grad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0,   1),
        NumberSequenceKeypoint.new(0.5, 0.5),
        NumberSequenceKeypoint.new(1,   1),
    })
    grad.Rotation = 0
    grad.Parent = shimmer
    return shimmer
end

local function playShimmer(shimmer, width)
    local origWidth = width or 80
    shimmer.Position = UDim2.new(0, -origWidth, 0, 0)
    shimmer.Size = UDim2.new(0, origWidth, 1, 0)
    TweenService:Create(shimmer, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        Position = UDim2.new(1, 0, 0, 0),
    }):Play()
end

