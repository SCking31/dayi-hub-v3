--==== MAIN SCRIPT LOADER ====--
local MAIN_SCRIPT_URL = "https://raw.githubusercontent.com/SCking31/dayi-hub-v3/refs/heads/main/dayi-hub-v3"

local function loadMainScript(plan)
    _G.DAYI_HUB_PLAN = plan or "free"
    local ok, result = pcall(function()
        return loadstring(game:HttpGet(MAIN_SCRIPT_URL))()
    end)
    if not ok then
        warn("[DAYI HUB] Failed to load main script: " .. tostring(result))
        return
    end

    -- Mobile fallback for remote main scripts that do not include the detector.
    -- A separate UIScale keeps the compact size through the main UI animations.
    if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
        task.spawn(function()
            task.wait(0.5)
            local deadline = os.clock() + 10
            while os.clock() < deadline do
                local hubGui = CoreGui:FindFirstChild("DAYI_HUB")
                if not hubGui then
                    hubGui = LocalPlayer:FindFirstChild("PlayerGui")
                        and LocalPlayer.PlayerGui:FindFirstChild("DAYI_HUB")
                end

                local mainFrame = hubGui and hubGui:FindFirstChild("MainFrame", true)
                if not mainFrame and hubGui then
                    for _, child in ipairs(hubGui:GetChildren()) do
                        if child:IsA("GuiObject") then
                            mainFrame = child
                            break
                        end
                    end
                end
                if mainFrame and mainFrame:IsA("GuiObject") then
                    local existingScale = mainFrame:FindFirstChildOfClass("UIScale")
                    if existingScale and existingScale.Scale <= 0.55 then
                        return
                    end

                    local mobileScale = mainFrame:FindFirstChild("DAYI_MobileScale")
                    if not mobileScale then
                        mobileScale = Instance.new("UIScale")
                        mobileScale.Name = "DAYI_MobileScale"
                        mobileScale.Parent = mainFrame
                    end
                    mobileScale.Scale = 0.5
                    return
                end
                task.wait(0.1)
            end
        end)
    end
end

