        BackgroundTransparency = 0.85,
        ZIndex = 7,
    })

    makeTextLabel(card, {
        Size = UDim2.new(1, 0, 0, 14),
        Position = UDim2.new(0, 0, 0, 438),
        Text = "v3.0  •  Protected by DayiHub Security",
        TextColor3 = C.TextFaint,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        ZIndex = 7,
    })

    --==== ENTRANCE ANIMATIONS ====--
    TweenService:Create(dim, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0.25}):Play()
    TweenService:Create(cardScale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()

    --==== LOGIC ====--
    local submitted = false

    local function validateKey(key)
        if key then
            local upper = key:upper()
            return VALID_KEYS[upper]
        end
        return nil
    end

    local function shakeFrame(frame, intensity, count)
        local origPos = frame.Position
        for i = 1, count or 3 do
            TweenService:Create(frame, TweenInfo.new(0.05), {
                Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + (intensity or 8), origPos.Y.Scale, origPos.Y.Offset),
            }):Play()
            task.wait(0.05)
            TweenService:Create(frame, TweenInfo.new(0.05), {
                Position = UDim2.new(origPos.X.Scale, origPos.X.Offset - (intensity or 8), origPos.Y.Scale, origPos.Y.Offset),
            }):Play()
            task.wait(0.05)
        end
        TweenService:Create(frame, TweenInfo.new(0.05), {Position = origPos}):Play()
    end

    local function handleSubmit()
        if submitted then return end
        local key = keyInput.Text
        if key == nil or key == "" then
            statusLabel.Text = "⚠  Please enter a key."
            statusLabel.TextColor3 = C.Amber
            shakeFrame(inputBg, 6, 2)
            return
        end

        submitted = true
        statusLabel.Text = "Verifying key..."
        statusLabel.TextColor3 = C.Purple
        progressBg.Visible = true
        progressFill.Size = UDim2.new(0, 0, 1, 0)

        TweenService:Create(progressFill, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            Size = UDim2.new(1, 0, 1, 0),
        }):Play()

        local dots = 0
        local dotActive = true
        task.spawn(function()
            while dotActive do
                dots = (dots + 1) % 4
                statusLabel.Text = "Verifying key" .. string.rep(".", dots)
                task.wait(0.3)
            end
        end)

        task.delay(0.9, function()
            dotActive = false
            local plan = validateKey(key)
            if plan then
                local planLabel = plan == "premium" and "Premium" or (plan == "developer" and "Developer" or "Free")
                statusLabel.Text = "✓  Key accepted! (" .. planLabel .. " plan) Loading..."
                statusLabel.TextColor3 = C.Green

                TweenService:Create(submitBtn, TweenInfo.new(0.2), {BackgroundColor3 = C.Green}):Play()
                TweenService:Create(borderStroke, TweenInfo.new(0.3), {Color = C.Green, Thickness = 3}):Play()
                TweenService:Create(progressFill, TweenInfo.new(0.2), {BackgroundColor3 = C.Green}):Play()

                task.delay(0.8, function()
                    TweenService:Create(cardScale, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.8}):Play()
                    TweenService:Create(dim, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {BackgroundTransparency = 1}):Play()
                    task.wait(0.35)
                    keyGui:Destroy()
                    loadMainScript(plan)
                end)
            else
                submitted = false
                progressBg.Visible = false
                statusLabel.Text = "✗  Invalid key. Try again."
                statusLabel.TextColor3 = C.Red

                TweenService:Create(borderStroke, TweenInfo.new(0.1), {Color = C.Red, Thickness = 3}):Play()
                task.delay(0.3, function()
                    TweenService:Create(borderStroke, TweenInfo.new(0.3), {Color = C.Purple, Thickness = 2}):Play()
                end)

                shakeFrame(card, 10, 3)

                keyInput.Text = ""
                keyInput:CaptureFocus()
            end
        end)
    end

    submitBtn.MouseButton1Click:Connect(handleSubmit)
    keyInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then handleSubmit() end
    end)

    getKeyBtn.MouseButton1Click:Connect(function()
        statusLabel.Text = "Join Discord for keys: discord.gg/QFwWBWM2j"
        statusLabel.TextColor3 = C.Purple
    end)

    task.wait(0.6)
    keyInput:CaptureFocus()
end

